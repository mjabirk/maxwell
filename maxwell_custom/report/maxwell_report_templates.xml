<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================================================================== -->
    <!-- UNIFIED MAXWELL MASTER LAYOUT TEMPLATE                                 -->
    <!-- Used by Sales Order, Purchase Order, and Customer Invoice / Bill       -->
    <!-- ====================================================================== -->
    <template id="maxwell_unified_document_layout">
        <div class="article maxwell-report-wrapper"
             t-att-data-oe-model="doc_obj and doc_obj._name"
             t-att-data-oe-id="doc_obj and doc_obj.id"
             style="font-family: 'Liberation Serif', 'Nimbus Roman', 'Times New Roman', Times, serif; color: #000000; background-color: #ffffff; font-size: 13.5px; padding: 0; margin: 0;">

            <!-- 1. TOP HEADER BANNER (Exact Maxwell English & Arabic Header + Divider) -->
            <div style="width: 100%; margin-bottom: 10px;">
                <img t-att-src="doc_obj._get_maxwell_banner_data_uri('header')"
                     style="width: 100%; height: auto; display: block;"
                     alt="Maxwell Trading and Contracting WLL"/>
            </div>

            <!-- 2. BILL TO BOX (LEFT) & ROUNDED DOCUMENT TITLE BOX (RIGHT) - Pure DIV layout (zero extra table lines) -->
            <div style="display: table; width: 100%; table-layout: fixed; margin-bottom: 12px;">
                <!-- Left: Bill To Box -->
                <div style="display: table-cell; width: 46%; vertical-align: top; border: 1px solid #444444;">
                    <div style="background-color: #c6c6c6; border-bottom: 1px solid #444444; padding: 4px 8px; font-weight: bold; font-size: 15px; font-family: 'Liberation Serif', 'Nimbus Roman', 'Times New Roman', Times, serif;">
                        <span>Bill To:</span>
                    </div>
                    <div style="padding: 6px 8px; min-height: 100px; font-size: 13.5px; line-height: 1.35; font-family: 'Liberation Serif', 'Nimbus Roman', 'Times New Roman', Times, serif;">
                        <t t-if="doc_obj.partner_id">
                            <div style="font-weight: bold;" t-out="doc_obj.partner_id.name"/>
                            <div t-if="doc_obj.partner_id.street" t-out="doc_obj.partner_id.street"/>
                            <div t-if="doc_obj.partner_id.street2" t-out="doc_obj.partner_id.street2"/>
                            <div>
                                <span t-if="doc_obj.partner_id.city" t-out="doc_obj.partner_id.city"/>
                                <span t-if="doc_obj.partner_id.city and doc_obj.partner_id.country_id">, </span>
                                <span t-if="doc_obj.partner_id.country_id" t-out="doc_obj.partner_id.country_id.name"/>
                            </div>
                            <div t-if="doc_obj.partner_id.phone">Tel: <span t-out="doc_obj.partner_id.phone"/></div>
                            <div t-if="doc_obj.partner_id.vat">TRN / Tax ID: <span t-out="doc_obj.partner_id.vat"/></div>
                        </t>
                    </div>
                </div>

                <!-- Middle Spacer -->
                <div style="display: table-cell; width: 4%;">&#160;</div>

                <!-- Right: Rounded Document Title & Number Box -->
                <div style="display: table-cell; width: 50%; vertical-align: top;">
                    <div style="background-color: #c6c6c6; border: 3.5px solid #5a5a5a; border-radius: 14px; padding: 10px 16px; min-height: 126px; box-sizing: border-box;">
                        <div style="text-align: center; font-weight: bold; font-size: 21px; font-family: 'Liberation Serif', 'Nimbus Roman', 'Times New Roman', Times, serif; letter-spacing: 0.5px; margin-bottom: 10px; color: #000000;">
                            <span t-out="doc_title"/>
                        </div>
                        <div style="font-family: 'Liberation Serif', 'Nimbus Roman', 'Times New Roman', Times, serif; font-size: 15px; line-height: 1.65; color: #000000;">
                            <div>
                                <span style="display: inline-block; width: 120px;" t-out="doc_number_label"/>
                                <span style="display: inline-block; width: 14px; text-align: center; font-weight: bold;">:</span>
                                <span style="font-weight: bold;" t-out="doc_number_val"/>
                            </div>
                            <div>
                                <span style="display: inline-block; width: 120px;" t-out="doc_date_label"/>
                                <span style="display: inline-block; width: 14px; text-align: center; font-weight: bold;">:</span>
                                <span t-out="doc_date_val"/>
                            </div>
                            <div>
                                <span style="display: inline-block; width: 120px;">Page No.</span>
                                <span style="display: inline-block; width: 14px; text-align: center; font-weight: bold;">:</span>
                                <span t-out="doc_obj.env.context.get('page_number', 1)"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. 4-COLUMN METADATA GRID (Supplier/Vendor ID, LPO, Customer ID, Quote Ref, Dates) -->
            <table class="o_ignore_layout_styling" style="width: 100%; border-collapse: collapse; border: 1px solid #000000; margin-bottom: 12px; font-family: 'Liberation Serif', 'Nimbus Roman', 'Times New Roman', Times, serif; font-size: 13.5px; color: #000000;">
                <colgroup>
                    <col style="width: 23%;"/>
                    <col style="width: 33%;"/>
                    <col style="width: 23%;"/>
                    <col style="width: 21%;"/>
                </colgroup>
                <tbody style="border: 0 none !important; border-style: none !important;">
                    <!-- Header Row 1 -->
                    <tr style="background-color: #c6c6c6; font-weight: bold; text-align: center; border: 0 none !important;">
                        <td style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 4px;">Supplier / Vendor ID</td>
                        <td style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 4px;">LPO Reference / No.</td>
                        <td style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 4px;">LPO Received on</td>
                        <td style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 4px;">Payment Terms</td>
                    </tr>
                    <!-- Data Row 1 -->
                    <tr style="background-color: #ffffff; text-align: center; height: 22px; border: 0 none !important;">
                        <td style="border: 1px solid #000000 !important; padding: 2px 4px;">
                            <span t-out="supplier_vendor_val or ''"/>&#160;
                        </td>
                        <td style="border: 1px solid #000000 !important; padding: 2px 4px;">
                            <span t-out="lpo_ref_val or ''"/>&#160;
                        </td>
                        <td style="border: 1px solid #000000 !important; padding: 2px 4px;">
                            <span t-out="lpo_received_val or ''"/>&#160;
                        </td>
                        <td style="border: 1px solid #000000 !important; padding: 2px 4px;">
                            <span t-out="payment_terms_val or ''"/>&#160;
                        </td>
                    </tr>
                    <!-- Header Row 2 -->
                    <tr style="background-color: #c6c6c6; font-weight: bold; text-align: center; line-height: 1.15; border: 0 none !important;">
                        <td style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 4px; vertical-align: middle;">Maxwell Customer ID</td>
                        <td style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 4px; vertical-align: middle;">Quote Reference No.</td>
                        <td style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 4px; vertical-align: middle;">Work Completed on</td>
                        <td style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 4px; vertical-align: middle;">Payment Due<br/>Date</td>
                    </tr>
                    <!-- Data Row 2 -->
                    <tr style="background-color: #ffffff; text-align: center; height: 22px; border: 0 none !important;">
                        <td style="border: 1px solid #000000 !important; padding: 2px 4px;">
                            <span t-out="maxwell_cust_val or ''"/>&#160;
                        </td>
                        <td style="border: 1px solid #000000 !important; padding: 2px 4px;">
                            <span t-out="quote_ref_val or ''"/>&#160;
                        </td>
                        <td style="border: 1px solid #000000 !important; padding: 2px 4px;">
                            <span t-out="work_completed_val or ''"/>&#160;
                        </td>
                        <td style="border: 1px solid #000000 !important; padding: 2px 4px;">
                            <span t-out="payment_due_val or ''"/>&#160;
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- 4. 6-COLUMN LINE ITEMS TABLE (Vertical column lines only, ZERO horizontal lines inside body) -->
            <table class="o_ignore_layout_styling maxwell-items-table" style="width: 100%; border-collapse: collapse; border: 1px solid #000000; margin-bottom: 5px; font-family: 'Liberation Serif', 'Nimbus Roman', 'Times New Roman', Times, serif; font-size: 13.5px; color: #000000;">
                <colgroup>
                    <col style="width: 8%;"/>
                    <col style="width: 48%;"/>
                    <col style="width: 8%;"/>
                    <col style="width: 10%;"/>
                    <col style="width: 11%;"/>
                    <col style="width: 15%;"/>
                </colgroup>
                <thead style="border: 0 none !important; border-style: none !important;">
                    <tr style="background-color: #c6c6c6; font-weight: bold; text-align: center; border: 0 none !important;">
                        <th style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 2px; text-align: center;">SL.No.</th>
                        <th style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 6px; text-align: center;">Description</th>
                        <th style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 2px; text-align: center;">Unit</th>
                        <th style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 2px; text-align: center;">Quantity</th>
                        <th style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 2px; text-align: center;">Unit Price</th>
                        <th style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 3px 4px; text-align: center;">Amount</th>
                    </tr>
                </thead>
                <tbody style="border: 0 none !important; border-style: none !important;">
                    <t t-set="sl_no" t-value="0"/>
                    <t t-set="visual_lines" t-value="0"/>
                    <t t-foreach="report_lines" t-as="line">
                        <t t-set="line_breaks" t-value="(line.name or '').count('\n') + 1"/>
                        <t t-set="visual_lines" t-value="visual_lines + line_breaks"/>
                        <t t-if="line.display_type in (False, 'product')">
                            <t t-set="sl_no" t-value="sl_no + 1"/>
                            <tr style="border: 0 none !important; border-style: none !important; height: 20px;">
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 4px; text-align: center; vertical-align: top;">
                                    <span t-out="sl_no"/>
                                </td>
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 6px; text-align: left; vertical-align: top;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 4px; text-align: center; vertical-align: top;">
                                    <span t-if="line.product_uom_id" t-out="line.product_uom_id.name"/>
                                </td>
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 6px; text-align: center; vertical-align: top;">
                                    <t t-if="doc_type == 'sale'">
                                        <span t-out="line.product_uom_qty" t-options='{"widget": "float", "precision": 2}'/>
                                    </t>
                                    <t t-elif="doc_type == 'purchase'">
                                        <span t-out="line.product_qty" t-options='{"widget": "float", "precision": 2}'/>
                                    </t>
                                    <t t-else="">
                                        <span t-out="line.quantity" t-options='{"widget": "float", "precision": 2}'/>
                                    </t>
                                </td>
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 6px; text-align: right; vertical-align: top;">
                                    <span t-out="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 6px; text-align: right; vertical-align: top;">
                                    <span t-out="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr style="border: 0 none !important; border-style: none !important; height: 20px;">
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 4px;">&#160;</td>
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 6px; font-weight: bold;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 4px;">&#160;</td>
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 4px;">&#160;</td>
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 4px;">&#160;</td>
                                <td style="border-top: 0 none !important; border-bottom: 0 none !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 2px 4px;">&#160;</td>
                            </tr>
                        </t>
                    </t>

                    <!-- Single continuous vertical filler row (NO horizontal lines inside products box) -->
                    <t t-set="spacer_height" t-value="max(8, 250 - (visual_lines * 18))"/>
                    <tr class="maxwell-items-bottom-row" t-attf-style="border: 0 none !important; border-style: none !important; height: #{spacer_height}px;">
                        <td style="border-top: 0 none !important; border-bottom: 1px solid #000000 !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 0;">&#160;</td>
                        <td style="border-top: 0 none !important; border-bottom: 1px solid #000000 !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 0;">&#160;</td>
                        <td style="border-top: 0 none !important; border-bottom: 1px solid #000000 !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 0;">&#160;</td>
                        <td style="border-top: 0 none !important; border-bottom: 1px solid #000000 !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 0;">&#160;</td>
                        <td style="border-top: 0 none !important; border-bottom: 1px solid #000000 !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 0;">&#160;</td>
                        <td style="border-top: 0 none !important; border-bottom: 1px solid #000000 !important; border-left: 1px solid #000000 !important; border-right: 1px solid #000000 !important; padding: 0;">&#160;</td>
                    </tr>
                </tbody>
            </table>

            <!-- 5. SUB TOTAL QAR & AMOUNT IN WORDS BOX -->
            <table class="o_ignore_layout_styling" style="width: 100%; border-collapse: collapse; border: 1px solid #000000; margin-bottom: 14px; font-family: 'Liberation Serif', 'Nimbus Roman', 'Times New Roman', Times, serif; font-size: 14px; color: #000000;">
                <colgroup>
                    <col style="width: 85%;"/>
                    <col style="width: 15%;"/>
                </colgroup>
                <tbody style="border: 0 none !important; border-style: none !important;">
                    <tr style="background-color: #ffffff; height: 24px; border: 0 none !important;">
                        <td style="border: 1px solid #000000 !important; padding: 4px 10px; text-align: right;">
                            Sub Total <span t-out="doc_obj.currency_id.name or 'QAR'"/>
                        </td>
                        <td style="border: 1px solid #000000 !important; padding: 4px 6px; text-align: right; font-weight: bold;">
                            <span t-out="doc_obj.amount_total" t-options='{"widget": "float", "precision": 2}'/>
                        </td>
                    </tr>
                    <tr style="background-color: #c6c6c6; height: 24px; border: 0 none !important;">
                        <td style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 4px 8px; text-align: left;">
                            <span style="font-weight: bold;">Amount In Words: </span>
                            <span t-out="doc_obj._get_maxwell_amount_in_words()"/>
                        </td>
                        <td style="border: 1px solid #000000 !important; background-color: #c6c6c6; padding: 4px 6px; text-align: right; font-weight: bold;">
                            &#160;
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- 6. SIGNATURES BOX (Prepared By & Received By - Pure DIV inner layout, zero extra lines) -->
            <table class="o_ignore_layout_styling" style="width: 100%; border-collapse: collapse; border: 1px solid #000000; margin-bottom: 8px; font-family: 'Liberation Serif', 'Nimbus Roman', 'Times New Roman', Times, serif; font-size: 14px; color: #000000;">
                <tbody style="border: 0 none !important; border-style: none !important;">
                    <tr style="border: 0 none !important; border-style: none !important;">
                        <!-- Left: Prepared By -->
                        <td style="width: 50%; border: 1px solid #000000 !important; padding: 8px 10px; vertical-align: top;">
                            <div style="font-weight: bold; text-decoration: underline; margin-bottom: 10px;">Prepared By</div>
                            <div style="margin-bottom: 8px;">Signature:</div>
                            <div>
                                <span style="display: inline-block; width: 105px;">Designation</span>
                                <span>: <span t-out="doc_obj.prepared_by_designation or 'Accountant'"/></span>
                            </div>
                            <div style="height: 68px;">&#160;</div>
                            <div>
                                <span style="display: inline-block; width: 105px;">Date</span>
                                <span>:</span>
                            </div>
                        </td>

                        <!-- Right: Received By -->
                        <td style="width: 50%; border: 1px solid #000000 !important; padding: 8px 10px; vertical-align: top;">
                            <div style="font-weight: bold; text-decoration: underline; margin-bottom: 10px;">Received By</div>
                            <div style="margin-bottom: 8px;">
                                <span style="display: inline-block; width: 118px;">Name &amp; Signature</span>
                                <span>:</span>
                            </div>
                            <div>
                                <span style="display: inline-block; width: 118px;">Designation</span>
                                <span>:</span>
                            </div>
                            <div style="height: 68px;">&#160;</div>
                            <div>
                                <span style="display: inline-block; width: 118px;">Date</span>
                                <span>:</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- 7. BANK TRANSFER DETAILS -->
            <div style="text-align: center; font-family: 'Liberation Serif', 'Nimbus Roman', 'Times New Roman', Times, serif; font-style: italic; font-size: 13.5px; line-height: 1.4; margin-top: 4px; margin-bottom: 6px; color: #000000;">
                <div>Account Details for the Payment’s Bank Transfer: -</div>
                <div style="font-weight: bold;">Maxwell Trading &amp; Contracting WLL</div>
                <div>Ac No.0252-040550-001, IBAN: QA22 QNBA 0000 0000 0252-040550-001</div>
                <div>Swift Code: QNBAQAQA, Qatar National Bank – Al Wakrah Branch</div>
            </div>

            <!-- 8. BOTTOM FOOTER BANNER (Superior Quality Exceptional Service + C.R.No / Address) -->
            <div style="width: 100%; margin-top: 4px;">
                <img t-att-src="doc_obj._get_maxwell_banner_data_uri('footer')"
                     style="width: 100%; height: auto; display: block;"
                     alt="Maxwell Footer"/>
            </div>

        </div>
    </template>

    <!-- ====================================================================== -->
    <!-- 1. INVOICE / BILL DOCUMENT (`account.move`)                            -->
    <!-- ====================================================================== -->
    <template id="report_invoice_document_maxwell">
        <t t-set="o" t-value="o.with_context(lang=lang)"/>
        <t t-set="doc_obj" t-value="o"/>
        <t t-set="doc_type" t-value="'invoice'"/>
        <t t-set="doc_title" t-value="'INVOICE'"/>
        <t t-set="doc_number_label" t-value="'Invoice Number'"/>
        <t t-set="doc_number_val" t-value="o.name if o.name and o.name != '/' else ''"/>
        <t t-set="doc_date_label" t-value="'Invoice Date'"/>
        <t t-set="doc_date_val" t-value="o.invoice_date.strftime('%d/%m/%Y') if o.invoice_date else ''"/>
        <t t-set="supplier_vendor_val" t-value="o.supplier_vendor_id or ''"/>
        <t t-set="lpo_ref_val" t-value="o.lpo_reference or o.ref or ''"/>
        <t t-set="lpo_received_val" t-value="o.lpo_received_date.strftime('%d/%m/%Y') if o.lpo_received_date else ''"/>
        <t t-set="payment_terms_val" t-value="o.invoice_payment_term_id.name if o.invoice_payment_term_id else ''"/>
        <t t-set="maxwell_cust_val" t-value="o.maxwell_customer_id or o.partner_id.ref or ''"/>
        <t t-set="quote_ref_val" t-value="o.quote_reference_no or o.invoice_origin or ''"/>
        <t t-set="work_completed_val" t-value="o.work_completed_date.strftime('%d/%m/%Y') if o.work_completed_date else ''"/>
        <t t-set="payment_due_val" t-value="o.invoice_date_due.strftime('%d/%m/%Y') if o.invoice_date_due else ''"/>
        <t t-set="report_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type in (False, 'product', 'line_section', 'line_subsection', 'line_note'))"/>
        <t t-call="maxwell_custom.maxwell_unified_document_layout"/>
    </template>

    <!-- Hook into account.report_invoice -->
    <template id="report_invoice_maxwell_inherit" inherit_id="account.report_invoice">
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
            <t t-elif="o._get_name_invoice_report() == 'maxwell_custom.report_invoice_document_maxwell'"
               t-call="maxwell_custom.report_invoice_document_maxwell"
               t-lang="lang"/>
        </xpath>
    </template>

    <!-- ====================================================================== -->
    <!-- 2. SALES ORDER / QUOTATION DOCUMENT (`sale.order`)                     -->
    <!-- ====================================================================== -->
    <template id="report_saleorder_document_maxwell">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="doc_obj" t-value="doc"/>
        <t t-set="doc_type" t-value="'sale'"/>
        <t t-set="doc_title" t-value="'SALES ORDER'"/>
        <t t-set="doc_number_label" t-value="'Order Number'"/>
        <t t-set="doc_number_val" t-value="doc.name or ''"/>
        <t t-set="doc_date_label" t-value="'Order Date'"/>
        <t t-set="doc_date_val" t-value="doc.date_order.strftime('%d/%m/%Y') if doc.date_order else ''"/>
        <t t-set="supplier_vendor_val" t-value="doc.supplier_vendor_id or ''"/>
        <t t-set="lpo_ref_val" t-value="doc.lpo_reference or doc.client_order_ref or ''"/>
        <t t-set="lpo_received_val" t-value="doc.lpo_received_date.strftime('%d/%m/%Y') if doc.lpo_received_date else ''"/>
        <t t-set="payment_terms_val" t-value="doc.payment_term_id.name if doc.payment_term_id else ''"/>
        <t t-set="maxwell_cust_val" t-value="doc.maxwell_customer_id or doc.partner_id.ref or ''"/>
        <t t-set="quote_ref_val" t-value="doc.quote_reference_no or doc.name or ''"/>
        <t t-set="work_completed_val" t-value="doc.work_completed_date.strftime('%d/%m/%Y') if doc.work_completed_date else (doc.commitment_date.strftime('%d/%m/%Y') if doc.commitment_date else '')"/>
        <t t-set="payment_due_val" t-value="doc.payment_due_date.strftime('%d/%m/%Y') if doc.payment_due_date else (doc.validity_date.strftime('%d/%m/%Y') if doc.validity_date else '')"/>
        <t t-set="report_lines" t-value="doc._get_order_lines_to_report()"/>
        <t t-call="maxwell_custom.maxwell_unified_document_layout"/>
    </template>

    <!-- Hook into sale.report_saleorder_raw & sale.report_saleorder_pro_forma -->
    <template id="report_saleorder_raw_maxwell_inherit" inherit_id="sale.report_saleorder_raw">
        <xpath expr='//t[@t-call="sale.report_saleorder_document"]' position="replace">
            <t t-call="maxwell_custom.report_saleorder_document_maxwell" t-lang="doc.partner_id.lang"/>
        </xpath>
    </template>

    <template id="report_saleorder_pro_forma_maxwell_inherit" inherit_id="sale.report_saleorder_pro_forma">
        <xpath expr='//t[@t-call="sale.report_saleorder_document"]' position="replace">
            <t t-call="maxwell_custom.report_saleorder_document_maxwell" t-lang="doc.partner_id.lang"/>
        </xpath>
    </template>

    <!-- ====================================================================== -->
    <!-- 3. PURCHASE ORDER / RFQ DOCUMENT (`purchase.order`)                    -->
    <!-- ====================================================================== -->
    <template id="report_purchaseorder_document_maxwell">
        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
        <t t-set="doc_obj" t-value="o"/>
        <t t-set="doc_type" t-value="'purchase'"/>
        <t t-set="doc_title" t-value="'PURCHASE ORDER'"/>
        <t t-set="doc_number_label" t-value="'PO Number'"/>
        <t t-set="doc_number_val" t-value="o.name or ''"/>
        <t t-set="doc_date_label" t-value="'PO Date'"/>
        <t t-set="doc_date_val" t-value="(o.date_approve or o.date_order).strftime('%d/%m/%Y') if (o.date_approve or o.date_order) else ''"/>
        <t t-set="supplier_vendor_val" t-value="o.supplier_vendor_id or o.partner_id.ref or ''"/>
        <t t-set="lpo_ref_val" t-value="o.lpo_reference or o.name or ''"/>
        <t t-set="lpo_received_val" t-value="o.lpo_received_date.strftime('%d/%m/%Y') if o.lpo_received_date else ''"/>
        <t t-set="payment_terms_val" t-value="o.payment_term_id.name if o.payment_term_id else ''"/>
        <t t-set="maxwell_cust_val" t-value="o.maxwell_customer_id or ''"/>
        <t t-set="quote_ref_val" t-value="o.quote_reference_no or o.partner_ref or ''"/>
        <t t-set="work_completed_val" t-value="o.work_completed_date.strftime('%d/%m/%Y') if o.work_completed_date else (o.date_planned.strftime('%d/%m/%Y') if o.date_planned else '')"/>
        <t t-set="payment_due_val" t-value="o.payment_due_date.strftime('%d/%m/%Y') if o.payment_due_date else ''"/>
        <t t-set="report_lines" t-value="o.order_line.filtered(lambda l: l.display_type or l.product_qty != 0)"/>
        <t t-call="maxwell_custom.maxwell_unified_document_layout"/>
    </template>

    <!-- Hook into purchase.report_purchaseorder & purchase.report_purchasequotation -->
    <template id="report_purchaseorder_maxwell_inherit" inherit_id="purchase.report_purchaseorder">
        <xpath expr='//t[@t-call="purchase.report_purchaseorder_document"]' position="replace">
            <t t-call="maxwell_custom.report_purchaseorder_document_maxwell" t-lang="o.partner_id.lang"/>
        </xpath>
    </template>

    <template id="report_purchasequotation_maxwell_inherit" inherit_id="purchase.report_purchasequotation">
        <xpath expr='//t[@t-call="purchase.report_purchasequotation_document"]' position="replace">
            <t t-call="maxwell_custom.report_purchaseorder_document_maxwell" t-lang="o.partner_id.lang"/>
        </xpath>
    </template>
</odoo>
