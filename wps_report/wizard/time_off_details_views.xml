<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_time_off_details_wizard" model="ir.ui.view">
        <field name="name">time.off.details.wizard.form</field>
        <field name="model">time.off.details.wizard</field>
        <field name="arch" type="xml">
            <form string="Time Off Details">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="holiday_type"/>
                    </group>
                </group>
                <footer>
                    <button name="print_report" string="Print" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_time_off_details_wizard" model="ir.actions.act_window">
        <field name="name">Time Off Details</field>
        <field name="res_model">time.off.details.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('hr_holidays.group_hr_holidays_manager'))]"/>
    </record>
</odoo>
