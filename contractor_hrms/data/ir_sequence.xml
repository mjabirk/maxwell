<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence for Agency Agreement -->
    <record id="seq_contractor_agency_agreement" model="ir.sequence">
        <field name="name">Manpower Agency Agreement Sequence</field>
        <field name="code">contractor.agency.agreement</field>
        <field name="prefix">AGR-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

