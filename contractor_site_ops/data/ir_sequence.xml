<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence for Site Schedule -->
    <record id="seq_contractor_site_schedule" model="ir.sequence">
        <field name="name">Site Staff Schedule Sequence</field>
        <field name="code">contractor.site.schedule</field>
        <field name="prefix">SCH-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Daily Progress Report (DPR) -->
    <record id="seq_contractor_daily_progress_report" model="ir.sequence">
        <field name="name">Daily Progress Report Sequence</field>
        <field name="code">contractor.daily.progress.report</field>
        <field name="prefix">DPR-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Site Attendance -->
    <record id="seq_contractor_site_attendance" model="ir.sequence">
        <field name="name">Daily Site Attendance Sequence</field>
        <field name="code">contractor.site.attendance</field>
        <field name="prefix">ATN-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Site Material Consumption -->
    <record id="seq_contractor_site_consumption" model="ir.sequence">
        <field name="name">Daily Site Material Consumption Sequence</field>
        <field name="code">contractor.site.consumption</field>
        <field name="prefix">SMC-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Subcontractor Work Log -->
    <record id="seq_contractor_site_work_log" model="ir.sequence">
        <field name="name">Site Work Log Sequence</field>
        <field name="code">contractor.site.work.log</field>
        <field name="prefix">CWL-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Site Issue -->
    <record id="seq_contractor_site_issue" model="ir.sequence">
        <field name="name">Site Issue Sequence</field>
        <field name="code">contractor.site.issue</field>
        <field name="prefix">ISSUE-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Daily Cost Posting -->
    <record id="seq_contractor_daily_cost_posting" model="ir.sequence">
        <field name="name">Daily Cost Posting Sequence</field>
        <field name="code">contractor.daily.cost.posting</field>
        <field name="prefix">DCP-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Cost Correction Request -->
    <record id="seq_contractor_cost_correction_request" model="ir.sequence">
        <field name="name">Cost Correction Request Sequence</field>
        <field name="code">contractor.cost.correction.request</field>
        <field name="prefix">CCR-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

