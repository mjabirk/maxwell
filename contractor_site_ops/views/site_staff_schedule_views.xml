<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contractor_site_schedule_form" model="ir.ui.view">
        <field name="name">contractor.site.schedule.form</field>
        <field name="model">contractor.site.schedule</field>
        <field name="arch" type="xml">
            <form string="Next-Day Site Staff Schedule">
                <header>
                    <button name="action_confirm_schedule"
                            string="Confirm &amp; Generate Attendance"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_copy_previous_schedule"
                            string="Copy Previous Schedule"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve_late_amendment"
                            string="Authorize Late Amendment"
                            type="object"
                            class="btn-warning"
                            invisible="not is_entry_locked or late_amendment_approved"
                            groups="contractor_core.group_contractor_project_manager"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="alert alert-danger py-2 mb-3" role="alert" invisible="not is_entry_locked">
                        <strong>48-Hour Site Entry Lock:</strong> This deployment schedule is locked past operational cutoff.
                        <span invisible="not late_amendment_approved">
                            (Late Amendment Authorized by <field name="late_amendment_approver_id" readonly="1" class="oe_inline"/> on <field name="late_amendment_approval_date" readonly="1" class="oe_inline"/> - Reason: <field name="late_amendment_reason" readonly="1" class="oe_inline"/>)
                        </span>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Schedule Reference"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Site &amp; Deployment Date">
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="schedule_date" readonly="state != 'draft'"/>
                            <field name="site_engineer_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_entry_locked" invisible="1"/>
                            <field name="late_amendment_approved" invisible="1"/>
                        </group>
                        <group string="Shift Summary &amp; Handoff">
                            <field name="total_workers" readonly="1"/>
                            <field name="total_planned_hours" readonly="1" widget="float_time"/>
                            <field name="attendance_id" readonly="1" invisible="not attendance_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Scheduled Operatives (Double-Booking Protected)" name="page_lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list string="Workforce Lines" editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="worker_category" widget="badge"
                                           decoration-info="worker_category == 'permanent'"
                                           decoration-warning="worker_category == 'temporary'"
                                           decoration-success="worker_category == 'manpower_supply'"/>
                                    <field name="job_title_id"/>
                                    <field name="planned_shift_hours" widget="float_time" sum="Total Planned Hours"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_contractor_site_schedule_list" model="ir.ui.view">
        <field name="name">contractor.site.schedule.list</field>
        <field name="model">contractor.site.schedule</field>
        <field name="arch" type="xml">
            <list string="Site Staff Schedules" default_order="schedule_date desc">
                <field name="name"/>
                <field name="project_id"/>
                <field name="schedule_date"/>
                <field name="site_engineer_id"/>
                <field name="total_workers"/>
                <field name="total_planned_hours" widget="float_time"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="is_entry_locked" widget="boolean" invisible="not is_entry_locked"/>
            </list>
        </field>
    </record>

    <record id="view_contractor_site_schedule_search" model="ir.ui.view">
        <field name="name">contractor.site.schedule.search</field>
        <field name="model">contractor.site.schedule</field>
        <field name="arch" type="xml">
            <search string="Search Site Staff Schedules">
                <field name="name"/>
                <field name="project_id"/>
                <field name="site_engineer_id"/>
                <field name="schedule_date"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Late Amendment Approved" name="late_amendment" domain="[('late_amendment_approved', '=', True)]"/>
                <group>
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Site Engineer" name="group_by_engineer" context="{'group_by': 'site_engineer_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Schedule Date" name="group_by_date" context="{'group_by': 'schedule_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_contractor_site_schedule_calendar" model="ir.ui.view">
        <field name="name">contractor.site.schedule.calendar</field>
        <field name="model">contractor.site.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Site Staff Schedules Calendar" date_start="schedule_date" color="project_id" mode="month">
                <field name="name"/>
                <field name="project_id" filters="1"/>
                <field name="site_engineer_id"/>
                <field name="total_workers"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_contractor_site_schedule" model="ir.actions.act_window">
        <field name="name">Site Staff Schedules</field>
        <field name="res_model">contractor.site.schedule</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_contractor_site_schedule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Plan next-day workforce deployment per project site with double-booking prevention.
            </p>
        </field>
    </record>
</odoo>

