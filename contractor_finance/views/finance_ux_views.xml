                    <button name="action_view_gate_exceptions" type="object" string="Inspect Records" icon="fa-external-link" class="btn btn-link btn-sm p-0" context="{'gate_key': 'gate_inventory_counts_reconciled'}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='gate_nca_depreciation_posted']" position="replace">
                <label for="gate_nca_depreciation_posted"/>
                <div class="d-flex align-items-center gap-2">
                    <field name="gate_nca_depreciation_posted" widget="boolean_toggle" readonly="state == 'locked'"/>
                    <button name="action_view_gate_exceptions" type="object" string="Inspect Records" icon="fa-external-link" class="btn btn-link btn-sm p-0" context="{'gate_key': 'gate_nca_depreciation_posted'}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='gate_provisions_reviewed']" position="replace">
                <label for="gate_provisions_reviewed"/>
                <div class="d-flex align-items-center gap-2">
                    <field name="gate_provisions_reviewed" widget="boolean_toggle" readonly="state == 'locked'"/>
                    <button name="action_view_gate_exceptions" type="object" string="Inspect Records" icon="fa-external-link" class="btn btn-link btn-sm p-0" context="{'gate_key': 'gate_provisions_reviewed'}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='gate_poc_revenue_wip_posted']" position="replace">
                <label for="gate_poc_revenue_wip_posted"/>
                <div class="d-flex align-items-center gap-2">
                    <field name="gate_poc_revenue_wip_posted" widget="boolean_toggle" readonly="state == 'locked'"/>
                    <button name="action_view_gate_exceptions" type="object" string="Inspect Records" icon="fa-external-link" class="btn btn-link btn-sm p-0" context="{'gate_key': 'gate_poc_revenue_wip_posted'}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='gate_retention_register_reviewed']" position="replace">
                <label for="gate_retention_register_reviewed"/>
                <div class="d-flex align-items-center gap-2">
                    <field name="gate_retention_register_reviewed" widget="boolean_toggle" readonly="state == 'locked'"/>
                    <button name="action_view_gate_exceptions" type="object" string="Inspect Records" icon="fa-external-link" class="btn btn-link btn-sm p-0" context="{'gate_key': 'gate_retention_register_reviewed'}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='gate_rpt_partner_accounts_reconciled']" position="replace">
                <label for="gate_rpt_partner_accounts_reconciled"/>
                <div class="d-flex align-items-center gap-2">
                    <field name="gate_rpt_partner_accounts_reconciled" widget="boolean_toggle" readonly="state == 'locked'"/>
                    <button name="action_view_gate_exceptions" type="object" string="Inspect Records" icon="fa-external-link" class="btn btn-link btn-sm p-0" context="{'gate_key': 'gate_rpt_partner_accounts_reconciled'}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='gate_project_profitability_generated']" position="replace">
                <label for="gate_project_profitability_generated"/>
                <div class="d-flex align-items-center gap-2">
                    <field name="gate_project_profitability_generated" widget="boolean_toggle" readonly="state == 'locked'"/>
