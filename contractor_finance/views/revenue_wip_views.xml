<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Project PoC WIP Schedule Form View -->
    <record id="view_contractor_project_wip_schedule_form" model="ir.ui.view">
        <field name="name">contractor.project.wip.schedule.form</field>
        <field name="model">contractor.project.wip.schedule</field>
        <field name="arch" type="xml">
            <form string="Project PoC WIP &amp; Revenue Schedule">
                <header>
                    <button name="action_fetch_project_data"
                            string="Fetch Contract &amp; Invoiced Amounts"
                            type="object"
                            class="btn btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_submit"
                            string="Submit WIP Schedule"
                            type="object"
                            class="btn btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            string="Approve Schedule"
                            type="object"
                            class="btn btn-success"
                            invisible="state != 'submitted'"
                            groups="contractor_core.group_contractor_manager"/>
                    <button name="action_post_wip_entry"
                            string="Post WIP Entry to GL"
                            type="object"
                            class="btn btn-primary"
                            invisible="state != 'approved'"
                            confirm="Are you sure you want to post this PoC WIP adjustment entry to the General Ledger? This action cannot be undone."
                            groups="contractor_core.group_contractor_senior_accountant,contractor_core.group_contractor_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="wip_classification != 'under_billing'">
                        <strong>Under-Billing Position (Contract Asset / WIP):</strong> Physical earned revenue (%s %.2f) exceeds certified client billings (%s %.2f).
                        A Contract Asset adjustment of %s %.2f is recognized in current assets.
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="wip_classification != 'over_billing'">
                        <strong>Over-Billing Position (Contract Liability / Billings in Excess):</strong> Client billings (%s %.2f) exceed physical earned revenue (%s %.2f).
                        A Contract Liability adjustment of %s %.2f is deferred in current liabilities.
                    </div>

                    <div class="oe_title">
                        <label for="name" string="WIP Schedule Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Project &amp; Cutoff Period">
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="period_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Contract Values (Baseline + VOs)">
                            <field name="baseline_contract_value" readonly="state != 'draft'"/>
                            <field name="approved_variation_order_value" readonly="state != 'draft'"/>
                            <field name="revised_contract_value" class="fw-bold" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Physical Certified Progress">
                            <field name="progress_calculation_basis" widget="radio" readonly="state != 'draft'"/>
                            <field name="certified_progress_pct" class="fw-bold fs-4" readonly="state != 'draft'"/>
                            <field name="milestone_certificate_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                        </group>
                        <group string="IFRS 15 Revenue &amp; WIP Position">
                            <field name="earned_revenue_to_date" readonly="1"/>
                            <field name="billed_to_date" readonly="state != 'draft'"/>
                            <field name="variance_amount" readonly="1"/>
                            <field name="wip_classification" widget="badge" decoration-info="wip_classification == 'under_billing'" decoration-warning="wip_classification == 'over_billing'" decoration-success="wip_classification == 'balanced'"/>
                            <field name="adjustment_amount" class="fw-bold fs-4 text-primary" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="General Ledger Accounts &amp; Audit" name="wip_gl">
                            <group>
                                <group string="Account Mappings">
                                    <field name="journal_id" readonly="state != 'draft'"/>
                                    <field name="revenue_adjustment_account_id" readonly="state != 'draft'"/>
                                    <field name="contract_asset_account_id" readonly="state != 'draft'"/>
                                    <field name="contract_liability_account_id" readonly="state != 'draft'"/>
                                </group>
                                <group string="Audit &amp; Journal Entry">
                                    <field name="account_move_id" readonly="1"/>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approval_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- WIP Schedule List View -->
    <record id="view_contractor_project_wip_schedule_list" model="ir.ui.view">
        <field name="name">contractor.project.wip.schedule.list</field>
        <field name="model">contractor.project.wip.schedule</field>
        <field name="arch" type="xml">
            <list string="PoC WIP &amp; Over/Under-Billing Schedules" decoration-info="wip_classification == 'under_billing'" decoration-warning="wip_classification == 'over_billing'">
                <field name="name"/>
                <field name="period_date"/>
                <field name="project_id"/>
                <field name="revised_contract_value"/>
                <field name="certified_progress_pct"/>
                <field name="earned_revenue_to_date" sum="Total Earned"/>
                <field name="billed_to_date" sum="Total Billed"/>
                <field name="wip_classification" widget="badge" decoration-info="wip_classification == 'under_billing'" decoration-warning="wip_classification == 'over_billing'"/>
                <field name="adjustment_amount" sum="Total Adjustment"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-warning="state == 'approved'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_contractor_project_wip_schedule_search" model="ir.ui.view">
        <field name="name">contractor.project.wip.schedule.search</field>
        <field name="model">contractor.project.wip.schedule</field>
        <field name="arch" type="xml">
            <search string="Search Project PoC WIP Schedules">
                <field name="name"/>
                <field name="project_id"/>
                <field name="period_date"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter string="Under-Billing (Contract Asset)" name="under_billing" domain="[('wip_classification', '=', 'under_billing')]"/>
                <filter string="Over-Billing (Contract Liability)" name="over_billing" domain="[('wip_classification', '=', 'over_billing')]"/>
                <filter string="Balanced" name="balanced" domain="[('wip_classification', '=', 'balanced')]"/>
                <group>
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="WIP Classification" name="group_by_wip_class" context="{'group_by': 'wip_classification'}"/>
                    <filter string="Progress Basis" name="group_by_basis" context="{'group_by': 'progress_calculation_basis'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Period Date" name="group_by_date" context="{'group_by': 'period_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_contractor_project_wip_schedule_pivot" model="ir.ui.view">
        <field name="name">contractor.project.wip.schedule.pivot</field>
        <field name="model">contractor.project.wip.schedule</field>
        <field name="arch" type="xml">
            <pivot string="Project PoC WIP Analysis">
                <field name="project_id" type="row"/>
                <field name="period_date" interval="month" type="col"/>
                <field name="earned_revenue_to_date" type="measure"/>
                <field name="billed_to_date" type="measure"/>
                <field name="adjustment_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_contractor_project_wip_schedule_graph" model="ir.ui.view">
        <field name="name">contractor.project.wip.schedule.graph</field>
        <field name="model">contractor.project.wip.schedule</field>
        <field name="arch" type="xml">
            <graph string="PoC Earned vs Billed Revenue" type="bar">
                <field name="project_id"/>
                <field name="earned_revenue_to_date" type="measure"/>
                <field name="billed_to_date" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action for WIP Schedules -->
    <record id="action_contractor_project_wip_schedule" model="ir.actions.act_window">
        <field name="name">Project PoC WIP Schedules</field>
        <field name="res_model">contractor.project.wip.schedule</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_contractor_project_wip_schedule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Compute percentage-of-completion (PoC) earned revenues and post monthly Contract Asset (WIP) or Contract Liability (Over-Billing) adjustments.
            </p>
        </field>
    </record>

</odoo>

