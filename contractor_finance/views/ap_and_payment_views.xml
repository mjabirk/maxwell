<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit account.move form for 3-Way Match & Vendor Advances -->
    <record id="view_move_form_contractor_finance" model="ir.ui.view">
        <field name="name">account.move.form.contractor.finance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_resolve_match_exception"
                        string="Clear 3-Way Match Hold"
                        type="object"
                        class="btn btn-warning"
                        invisible="not is_match_hold"
                        groups="contractor_core.group_contractor_senior_accountant,contractor_core.group_contractor_manager"/>
                <button name="action_apply_vendor_advance"
                        string="Apply Vendor Advance"
                        type="object"
                        class="btn btn-info"
                        invisible="move_type != 'in_invoice' or not has_unadjusted_vendor_advance"
                        groups="contractor_core.group_contractor_accountant"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger" role="alert" invisible="not is_match_hold">
                    <strong>3-Way Match Hold Active:</strong> Billed quantities or prices mismatch Purchase Order / GRN records.
                    Posting and payment release are blocked until resolved.
                </div>
                <div class="alert alert-info" role="alert" invisible="not has_unadjusted_vendor_advance">
                    <strong>Open Vendor Mobilization Advance:</strong> A total of
                    <field name="open_vendor_advance_amount" widget="monetary" readonly="1"/>
                    remains unadjusted against this PO. Consider deducting it on this bill.
                </div>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="project_id" options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']" position="after">
                <field name="project_id" optional="show"/>
            </xpath>

            <xpath expr="//page[@id='other_tab']" position="inside">
                <group string="Construction AP &amp; 3-Way Match Governance" invisible="move_type != 'in_invoice'">
                    <group>
                        <field name="three_way_match_status" widget="badge"
                               decoration-success="three_way_match_status == 'matched'"
                               decoration-danger="three_way_match_status == 'exception'"
                               decoration-warning="three_way_match_status == 'manually_cleared'"/>
                        <field name="is_match_hold" readonly="1"/>
                        <field name="match_exception_reason" invisible="not match_exception_reason" readonly="1"/>
                    </group>
                    <group>
                        <field name="cleared_by_id" invisible="three_way_match_status != 'manually_cleared'" readonly="1"/>
                        <field name="cleared_date" invisible="three_way_match_status != 'manually_cleared'" readonly="1"/>
                        <field name="advance_adjustment_amount"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit account.payment form for 3-Step Maker-Checker & Vendor Advance -->
    <record id="view_account_payment_form_contractor_finance" model="ir.ui.view">
        <field name="name">account.payment.form.contractor.finance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_prepare_payment"
                        string="Step 1: Certify &amp; Prepare Payment"
                        type="object"
                        class="btn btn-primary"
                        invisible="payment_workflow_state != 'draft'"
                        groups="contractor_core.group_contractor_accountant,contractor_core.group_contractor_senior_accountant"/>
                <button name="action_approve_payment"
                        string="Step 2: Manager Approve Payment"
                        type="object"
                        class="btn btn-success"
                        invisible="payment_workflow_state != 'prepared'"
                        groups="contractor_core.group_contractor_manager"/>
                <button name="action_release_payment"
                        string="Step 3: Release &amp; Disburse Payment"
                        type="object"
                        class="btn btn-primary"
                        invisible="payment_workflow_state != 'approved'"
                        groups="contractor_core.group_contractor_senior_accountant,contractor_core.group_contractor_manager"/>
                <field name="payment_workflow_state" widget="statusbar" statusbar_visible="draft,prepared,approved,released"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Contractor Disbursement &amp; Advance Control">
                    <group string="Procurement Linkage">
                        <field name="is_vendor_advance" readonly="payment_workflow_state != 'draft'"/>
                        <field name="purchase_order_id" invisible="not is_vendor_advance" readonly="payment_workflow_state != 'draft'"/>
                        <field name="vendor_advance_adjusted" invisible="not is_vendor_advance" readonly="1"/>
                    </group>
                    <group string="3-Step Maker-Checker Audit Trail">
                        <field name="prepared_by_id" readonly="1"/>
                        <field name="preparation_date" readonly="1"/>
                        <field name="approved_by_id" readonly="1"/>
                        <field name="approval_date" readonly="1"/>
                        <field name="released_by_id" readonly="1"/>
                        <field name="release_date" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>

