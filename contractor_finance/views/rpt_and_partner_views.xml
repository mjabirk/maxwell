<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Related Party Register Form View -->
    <record id="view_contractor_related_party_form" model="ir.ui.view">
        <field name="name">contractor.related.party.form</field>
        <field name="model">contractor.related.party</field>
        <field name="arch" type="xml">
            <form string="Related Party (RPT) Profile">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Related Party Entity / Individual"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Statutory Relationship">
                            <field name="partner_id"/>
                            <field name="relationship_type"/>
                            <field name="holding_percentage"/>
                        </group>
                        <group string="Company &amp; Status">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Disclosures &amp; Affiliation Notes">
                        <field name="notes" placeholder="Enter nature of control, common directorships, and family ties..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Related Party List View -->
    <record id="view_contractor_related_party_list" model="ir.ui.view">
        <field name="name">contractor.related.party.list</field>
        <field name="model">contractor.related.party</field>
        <field name="arch" type="xml">
            <list string="Related Party Register">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="relationship_type"/>
                <field name="holding_percentage"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_contractor_related_party_search" model="ir.ui.view">
        <field name="name">contractor.related.party.search</field>
        <field name="model">contractor.related.party</field>
        <field name="arch" type="xml">
            <search string="Search Related Parties">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Shareholders" name="shareholder" domain="[('relationship_type', '=', 'shareholder')]"/>
                <filter string="Directors" name="director" domain="[('relationship_type', '=', 'director')]"/>
                <filter string="Key Management" name="key_management" domain="[('relationship_type', '=', 'key_management')]"/>
                <filter string="Affiliates" name="affiliate" domain="[('relationship_type', '=', 'affiliate_company')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Relationship Type" name="group_by_relationship" context="{'group_by': 'relationship_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Related Parties -->
    <record id="action_contractor_related_party" model="ir.actions.act_window">
        <field name="name">Related Party (RPT) Register</field>
        <field name="res_model">contractor.related.party</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contractor_related_party_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Maintain a formal statutory register of shareholders, directors, key executives, and affiliated entities.
            </p>
        </field>
    </record>

    <!-- ================================================================= -->
    <!-- Partner & Shareholder Dedicated Current Account                   -->
    <!-- ================================================================= -->
    <record id="view_contractor_partner_current_account_form" model="ir.ui.view">
        <field name="name">contractor.partner.current.account.form</field>
        <field name="model">contractor.partner.current.account</field>
        <field name="arch" type="xml">
            <form string="Partner / Shareholder Current Account">
                <header>
                    <button name="action_reconcile_month_end"
                            string="Certify Month-End Reconciliation"
                            type="object"
                            class="btn btn-primary"
                            groups="contractor_core.group_contractor_senior_accountant,contractor_core.group_contractor_manager"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not has_long_outstanding_balance">
                        <strong>Aged Partner Current Account Balance (90+ Days):</strong> Document a settlement / resolution plan prior to month-end close certification.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Account Title"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Partner Identification">
                            <field name="partner_id"/>
                            <field name="rpt_id"/>
                            <field name="account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Equity &amp; Drawing Balances">
                            <field name="total_injections" readonly="1"/>
                            <field name="total_drawings" readonly="1"/>
                            <field name="net_partner_balance" class="fw-bold fs-4 text-primary" readonly="1"/>
                            <field name="last_reconciled_date" readonly="1"/>
                            <field name="last_reconciled_by_id" readonly="1"/>
                            <field name="has_long_outstanding_balance" readonly="1"/>
                            <field name="resolution_plan" required="has_long_outstanding_balance"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Drawings, Advances &amp; Injections" name="partner_lines">
                            <field name="line_ids">
                                <list string="Partner Account Movements" editable="bottom">
                                    <field name="date"/>
                                    <field name="transaction_type"/>
                                    <field name="amount"/>
                                    <field name="purpose"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-warning="state == 'approved'" decoration-info="state == 'draft'"/>
                                    <button name="action_approve"
                                            string="MD Approve"
                                            type="object"
                                            class="btn btn-sm btn-outline-warning"
                                            invisible="state != 'draft'"
                                            groups="contractor_core.group_contractor_md"/>
                                    <button name="action_post"
                                            string="Post GL Move"
                                            type="object"
                                            class="btn btn-sm btn-primary"
                                            invisible="state != 'approved'"
                                            groups="contractor_core.group_contractor_senior_accountant,contractor_core.group_contractor_manager"/>
                                    <field name="move_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Partner Current Account List View -->
    <record id="view_contractor_partner_current_account_list" model="ir.ui.view">
        <field name="name">contractor.partner.current.account.list</field>
        <field name="model">contractor.partner.current.account</field>
        <field name="arch" type="xml">
            <list string="Partner Current Accounts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="total_injections" sum="Total Injected"/>
                <field name="total_drawings" sum="Total Drawn"/>
                <field name="net_partner_balance" sum="Total Net Equity"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_contractor_partner_current_account_search" model="ir.ui.view">
        <field name="name">contractor.partner.current.account.search</field>
        <field name="model">contractor.partner.current.account</field>
        <field name="arch" type="xml">
            <search string="Search Partner Current Accounts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="rpt_id"/>
                <field name="account_id"/>
                <group>
                    <filter string="Partner / Shareholder" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Account" name="group_by_account" context="{'group_by': 'account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Partner Current Accounts -->
    <record id="action_contractor_partner_current_account" model="ir.actions.act_window">
        <field name="name">Partner Current Accounts</field>
        <field name="res_model">contractor.partner.current.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contractor_partner_current_account_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Track shareholder capital injections, personal drawings, and advances in dedicated equity ledgers.
            </p>
        </field>
    </record>

    <!-- Inherit account.move to display RPT Controls -->
    <record id="view_move_form_rpt_contractor" model="ir.ui.view">
        <field name="name">account.move.form.rpt.contractor</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approve_rpt"
                        string="Approve Material RPT"
                        type="object"
                        class="btn btn-outline-warning"
                        invisible="not is_rpt_transaction or rpt_manager_approved"
                        groups="contractor_core.group_contractor_manager,contractor_core.group_contractor_md"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" invisible="not is_rpt_transaction">
                    <strong>Related Party Transaction (RPT):</strong> Counterparty is recognized in the statutory Related Party Register.
                    Ensure arm's length commercial pricing or documented Board justification.
                </div>
            </xpath>

            <xpath expr="//page[@id='other_tab']" position="inside">
                <group string="Related Party (RPT) Governance" invisible="not is_rpt_transaction">
                    <group>
                        <field name="is_rpt_transaction" readonly="1"/>
                        <field name="rpt_id" readonly="1"/>
                        <field name="rpt_nature"/>
                        <field name="is_arms_length"/>
                    </group>
                    <group>
                        <field name="arms_length_deviation_justification" invisible="is_arms_length" required="not is_arms_length"/>
                        <field name="rpt_manager_approved" readonly="1"/>
                        <field name="rpt_manager_approver_id" invisible="not rpt_manager_approved" readonly="1"/>
                        <field name="rpt_manager_approval_date" invisible="not rpt_manager_approved" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit sale.order & purchase.order for Point-of-Entry RPT Disclosure -->
    <record id="view_order_form_rpt_contractor" model="ir.ui.view">
        <field name="name">sale.order.form.rpt.contractor</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" invisible="not is_rpt_transaction">
                    <strong>Related Party Transaction (RPT):</strong> Customer is registered in the statutory Related Party Register.
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_rpt_transaction" invisible="1"/>
                <field name="rpt_id" invisible="not is_rpt_transaction" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_rpt_contractor" model="ir.ui.view">
        <field name="name">purchase.order.form.rpt.contractor</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" invisible="not is_rpt_transaction">
                    <strong>Related Party Transaction (RPT):</strong> Vendor is registered in the statutory Related Party Register.
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_rpt_transaction" invisible="1"/>
                <field name="rpt_id" invisible="not is_rpt_transaction" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>

