<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Level Contractor ERP Application Menu -->
    <menuitem id="menu_contractor_root"
              name="Contractor ERP"
              sequence="15"
              groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_site_engineer,contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_storekeeper,contractor_core.group_contractor_hr_officer,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager,base.group_system"
              web_icon="contractor_core,static/description/icon.png"/>

    <!-- Top Level Section: Document Governance -->
    <menuitem id="menu_contractor_document_control"
              name="Document Governance"
              parent="menu_contractor_root"
              sequence="20"
              groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_site_engineer,contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager,base.group_system"/>

    <menuitem id="menu_contractor_version_snapshots"
              name="Version Snapshots"
              parent="menu_contractor_document_control"
              action="action_contractor_document_version"
              sequence="10"
              groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_site_engineer,contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager,base.group_system"/>

    <!-- Top Level Section: Workforce & Rates -->
    <menuitem id="menu_contractor_hr_governance"
              name="Labor Governance"
              parent="menu_contractor_root"
              sequence="30"
              groups="contractor_core.group_contractor_hr_officer,contractor_core.group_contractor_senior_accountant,contractor_core.group_contractor_manager,base.group_system"/>

    <menuitem id="menu_contractor_rate_histories"
              name="Labor Rate Histories"
              parent="menu_contractor_hr_governance"
              action="action_contractor_dated_rate_history"
              sequence="10"
              groups="contractor_core.group_contractor_hr_officer,contractor_core.group_contractor_senior_accountant,contractor_core.group_contractor_manager,base.group_system"/>

    <!-- Top Level Section: Configuration -->
    <menuitem id="menu_contractor_configuration"
              name="Configuration"
              parent="menu_contractor_root"
              sequence="90"
              groups="base.group_erp_manager,base.group_system"/>
    <record id="menu_contractor_configuration" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_erp_manager'), ref('base.group_system')])]"/>
    </record>

    <menuitem id="menu_contractor_settings"
              name="Settings"
              parent="menu_contractor_configuration"
              action="action_contractor_config_settings"
              sequence="10"
              groups="base.group_erp_manager,base.group_system"/>
    <record id="menu_contractor_settings" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_erp_manager'), ref('base.group_system')])]"/>
    </record>

    <menuitem id="menu_contractor_approval_roles"
              name="Approval Roles &amp; Groups"
              parent="menu_contractor_configuration"
              action="action_contractor_security_groups"
              sequence="20"
              groups="base.group_erp_manager,base.group_system"/>
    <record id="menu_contractor_approval_roles" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_erp_manager'), ref('base.group_system')])]"/>
    </record>
</odoo>
