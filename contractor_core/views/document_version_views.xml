<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_contractor_document_version_list" model="ir.ui.view">
        <field name="name">contractor.document.version.list</field>
        <field name="model">contractor.document.version</field>
        <field name="arch" type="xml">
            <list string="Version Snapshots" create="0" delete="0" edit="0">
                <field name="version_number" decoration-bf="1"/>
                <field name="name"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="timestamp"/>
                <field name="editor_id" widget="many2one_avatar_user"/>
                <field name="approval_state" widget="badge"/>
                <field name="total_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="margin" widget="percentage"/>
                <field name="attachment_count" string="Attachments"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_contractor_document_version_form" model="ir.ui.view">
        <field name="name">contractor.document.version.form</field>
        <field name="model">contractor.document.version</field>
        <field name="arch" type="xml">
            <form string="Document Version Snapshot" create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Version Snapshot"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Snapshot Metadata">
                            <field name="version_number"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="timestamp"/>
                            <field name="editor_id"/>
                            <field name="approval_state"/>
                        </group>
                        <group string="Financial Position at Snapshot">
                            <field name="total_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="margin"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revision Justification" name="page_reason">
                            <field name="reason" readonly="1" widget="text"/>
                        </page>
                        <page string="Rendered Snapshot Preview" name="page_preview">
                            <field name="snapshot_html" widget="html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Raw JSON Payload" name="page_raw_json">
                            <field name="snapshot_data" readonly="1" widget="ace" options="{'mode': 'json'}" nolabel="1"/>
                        </page>
                        <page string="Attachments" name="page_attachments">
                            <field name="attachment_ids" widget="many2many_binary" string="Archived Version Attachments" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_contractor_document_version_search" model="ir.ui.view">
        <field name="name">contractor.document.version.search</field>
        <field name="model">contractor.document.version</field>
        <field name="arch" type="xml">
            <search string="Search Version Snapshots">
                <field name="name"/>
                <field name="res_model"/>
                <field name="editor_id"/>
                <filter string="My Snapshots" name="my_snapshots" domain="[('editor_id', '=', uid)]"/>
                <group>
                    <filter string="Document Model" name="group_res_model" domain="[]" context="{'group_by': 'res_model'}"/>
                    <filter string="Editor" name="group_editor" domain="[]" context="{'group_by': 'editor_id'}"/>
                    <filter string="Date" name="group_date" domain="[]" context="{'group_by': 'timestamp:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_contractor_document_version" model="ir.actions.act_window">
        <field name="name">Version Snapshots</field>
        <field name="res_model">contractor.document.version</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contractor_document_version_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No immutable document snapshots created yet.
            </p>
            <p>
                Snapshots are automatically created upon major document revisions, scope variations, and approvals.
            </p>
        </field>
    </record>
</odoo>

