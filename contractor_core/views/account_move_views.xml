<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_legacy_import_core" model="ir.ui.view">
        <field name="name">account.move.form.legacy.import.contractor.core</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">65</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" role="status" invisible="not is_legacy_import">
                    <strong>Imported Legacy Record:</strong> Historical entry migrated from legacy system (exempt from mandatory Project Code enforcement).
                </div>
            </xpath>
            <xpath expr="//page[@id='other_tab']" position="inside">
                <group string="Legacy Migration Status" invisible="not is_legacy_import">
                    <field name="is_legacy_import" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
