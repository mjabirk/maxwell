<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_contractor_menu_restriction" model="ir.ui.view">
        <field name="name">res.users.form.inherit.contractor.menu.restriction</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Contractor Menu Governance" groups="base.group_system,contractor_core.group_contractor_manager">
                    <field name="contractor_menu_mode"/>
                    <field name="contractor_hidden_menu_ids" widget="many2many_tags" options="{'no_create': True}" invisible="contractor_menu_mode == 'unrestricted'"/>
                </group>
            </xpath>
        </field>
    </record>

    <function model="res.users" name="_cleanup_contractor_privilege_groups"/>
</odoo>
