<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contractor_reason_wizard_form" model="ir.ui.view">
        <field name="name">contractor.reason.wizard.form</field>
        <field name="model">contractor.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Document Governance Action">
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert">
                        <strong>Mandatory Platform Governance Notice:</strong>
                        A documented business reason is required before confirming this action. This justification will be logged permanently in the document audit trail.
                    </div>
                    <group>
                        <group>
                            <field name="action_type" readonly="1"/>
                            <field name="target_state" invisible="not target_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                            <field name="callback_method" invisible="1"/>
                        </group>
                    </group>
                    <group string="Justification">
                        <field name="reason" placeholder="Explain the rationale, discrepancies, deficiencies, or strategic reasons for this action (min 5 characters)..." nolabel="1" colspan="2" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm Action" name="action_confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

