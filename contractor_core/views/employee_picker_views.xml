<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_contractor_picker_list" model="ir.ui.view">
        <field name="name">hr.employee.list.contractor.picker</field>
        <field name="model">hr.employee</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <list string="Employees" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="job_title"/>
                <field name="department_id"/>
                <field name="work_email" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
</odoo>
