<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_contractor_estimation" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.contractor.estimation</field>
        <field name="model">sale.order</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Replace or Augment Header Buttons & Workflow -->
            <xpath expr="//header" position="inside">
                <!-- 1. Engineer Submission Button -->
                <button name="action_submit_for_approval"
                        type="object"
                        string="Submit for Manager Approval"
                        class="btn-primary"
                        invisible="contractor_quote_state != 'draft'"/>

                <!-- 2. Manager 3-Option Review Buttons -->
                <button name="action_manager_approve"
                        type="object"
                        string="Manager Approve (As-Is)"
                        class="btn-success"
                        invisible="contractor_quote_state != 'submitted'"
                        groups="contractor_core.group_contractor_manager"/>

                <button name="action_manager_edit_and_approve"
                        type="object"
                        string="Manager Edit &amp; Approve (v2 Snapshot)"
                        class="btn-primary"
                        invisible="contractor_quote_state != 'submitted'"
                        groups="contractor_core.group_contractor_manager"/>

                <button name="action_manager_return"
                        type="object"
                        string="Manager Return (Correction)"
                        class="btn-warning"
                        invisible="contractor_quote_state != 'submitted'"
                        groups="contractor_core.group_contractor_manager"/>

                <button name="action_approve_margin_override"
                        type="object"
                        string="Approve Margin Override"
                        class="btn-outline-danger"
                        invisible="margin_override_approved or contractor_quote_state not in ('draft', 'submitted')"
                        groups="contractor_core.group_contractor_manager"/>

                <!-- 3. Sales Admin Client Dispatch Gate -->
                <button name="action_confirm_client_dispatch"
                        type="object"
                        string="Sales Release: Dispatch to Client"
                        class="btn-success"
                        invisible="contractor_quote_state != 'approved_pending_release'"
                        groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_manager"/>

                <!-- 4. Client Negotiation & Non-Conversion Follow-up -->
                <button name="action_log_client_negotiation"
                        type="object"
                        string="Log Client Negotiation"
                        class="btn-secondary"
                        invisible="contractor_quote_state not in ('sent_to_client', 'under_negotiation')"/>
                <button name="action_revise_quotation"
                        type="object"
                        string="Revise Quotation (New Version)"
                        class="btn-warning"
                        invisible="contractor_quote_state not in ('approved_pending_release', 'sent_to_client', 'under_negotiation', 'accepted')"/>

                <button name="action_log_non_conversion_status"
                        type="object"
                        string="Update Non-Conversion Status"
                        class="btn-outline-warning"
                        invisible="contractor_quote_state not in ('approved_pending_release', 'sent_to_client', 'under_negotiation', 'accepted') or project_id"
                        groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_manager"/>

                <!-- 5. Customer Acceptance & Project Conversion -->
                <button name="action_customer_acceptance"
                        type="object"
                        string="Record Customer Acceptance"
                        class="btn-info"
                        invisible="contractor_quote_state not in ('sent_to_client', 'under_negotiation')"/>

                <button name="action_convert_to_project"
                        type="object"
                        string="Convert to Active Project &amp; Master Budget"
                        class="btn-success"
                        invisible="contractor_quote_state != 'accepted'"/>

                <!-- 6. Cancellation / Lost / Declined / Revision Governance -->
                <button name="action_set_quote_lost"
                        type="object"
                        string="Mark as Lost"
                        class="btn-outline-danger"
                        invisible="contractor_quote_state not in ('sent_to_client', 'under_negotiation')"/>

                <button name="action_set_quote_declined"
                        type="object"
                        string="Client Declined"
                        class="btn-outline-danger"
                        invisible="contractor_quote_state not in ('sent_to_client', 'under_negotiation')"/>

                <button name="action_create_new_revision"
                        type="object"
                        string="Generate New Quotation (New Revision)"
                        class="btn-primary"
                        invisible="contractor_quote_state not in ('cancelled', 'declined', 'lost') and state != 'cancel'"/>
            </xpath>

            <!-- Hide standard Odoo Confirm buttons (handled via Convert to Active Project) & Customize Cancel / Reset -->
            <xpath expr="//button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][not(@id)]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="confirm"/>
                <attribute name="invisible">contractor_quote_state in ('converted', 'cancelled', 'lost', 'declined') or state == 'cancel' or not id or locked</attribute>
            </xpath>
            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="string">Reset to Draft (In-Place New Version)</attribute>
                <attribute name="invisible">contractor_quote_state not in ('cancelled', 'declined', 'lost') and state != 'cancel'</attribute>
            </xpath>

            <!-- Revision Count Stat Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_revisions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-code-fork"
                        invisible="revision_count == 0">
                    <field name="revision_count" widget="statinfo" string="Revisions"/>
                </button>
            </xpath>

            <!-- Statusbar Widget -->
            <xpath expr="//header" position="after">
                <field name="margin_meets_minimum" invisible="1"/>
                <field name="min_required_margin_pct" invisible="1"/>
                <field name="is_approved_step" invisible="1"/>
                <field name="is_dispatched_step" invisible="1"/>
                <field name="is_acceptance_attached_step" invisible="1"/>
                <field name="conversion_ready" invisible="1"/>
                <field name="has_missing_new_sku_cost_basis" invisible="1"/>
                <div class="alert alert-secondary border py-2 mb-1 d-flex flex-wrap justify-content-between align-items-center" role="status" string="Live Margin &amp; Cost Simulator" invisible="total_estimated_cost &lt;= 0">
                    <div>
                        <span class="text-muted small text-uppercase me-1">Total Cost:</span>
                        <strong class="me-3"><field name="total_estimated_cost" widget="monetary" readonly="1" class="oe_inline"/></strong>
                        <span groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager">
                            <span class="text-muted small text-uppercase me-1">Proposed Margin %:</span>
                            <strong class="text-success me-3" invisible="not margin_meets_minimum"><field name="effective_margin_pct" readonly="1" class="oe_inline"/>%</strong>
                            <strong class="text-danger me-3" invisible="margin_meets_minimum"><field name="effective_margin_pct" readonly="1" class="oe_inline"/>% <span class="badge text-bg-danger" invisible="margin_override_approved">Override Required</span></strong>
                            <span class="text-muted small text-uppercase me-1">Min Required:</span>
                            <strong class="me-3"><field name="min_required_margin_pct" readonly="1" class="oe_inline"/>%</strong>
                            <span class="text-muted small text-uppercase me-1">Final Quotation Value:</span>
                            <strong class="fs-6"><field name="proposed_quotation_value" widget="monetary" readonly="1" class="oe_inline"/></strong>
                        </span>
                    </div>
                </div>
                <div class="alert alert-light border py-2 mb-1 d-flex flex-wrap gap-3 align-items-center" role="status" invisible="contractor_quote_state in ('draft', 'cancelled', 'lost', 'converted')">
                    <strong>Project Conversion Checklist:</strong>
                    <span class="text-success" invisible="not is_approved_step">[✓] Quotation Approved</span>
                    <span class="text-muted" invisible="is_approved_step">[ ] Quotation Approved</span>
                    <span class="text-success" invisible="not is_dispatched_step">[✓] Dispatched to Client</span>
                    <span class="text-warning" invisible="is_dispatched_step">[!] Dispatched to Client</span>
                    <span class="text-success" invisible="not is_acceptance_attached_step">[✓] Customer Acceptance Document Attached</span>
                    <span class="text-danger fw-bold" invisible="is_acceptance_attached_step">[!] Customer Acceptance Document Missing</span>
                </div>
                <div class="alert alert-info py-2 mb-0" role="alert" invisible="contractor_quote_state != 'approved_pending_release'">
                    <strong>Sales Release SLA Pending (24h):</strong>
                    This quotation has been approved by Contractor Management. Sales Administration must review commercial terms and dispatch to the client.
                </div>
                <div class="alert alert-warning py-2 mb-0" role="alert" invisible="not has_new_sku_cost_lines or contractor_quote_state not in ('draft', 'submitted')">
                    <strong>New SKU Manager Cost Review Flagged:</strong>
                    This quotation contains manually priced non-catalog materials that require explicit Manager review of vendor quotes / cost basis.
                </div>
                <div class="alert alert-danger py-2 mb-0" role="alert" invisible="contractor_quote_state not in ('cancelled', 'declined', 'lost')">
                    <strong>Closed / Cancelled Quotation:</strong>
                    Use <b>Generate New Quotation (New Revision)</b> above to create a linked draft revision carrying forward all 4 cost estimation blocks.
                </div>
            </xpath>

            <!-- Add contractor_quote_state to header -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="contractor_quote_state" widget="statusbar" statusbar_visible="draft,submitted,approved_pending_release,sent_to_client,under_negotiation,accepted,converted"/>
            </xpath>

            <!-- Lead, Project & Revision Link in Header/Upper Form -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="lead_id" readonly="contractor_quote_state != 'draft'"/>
                <field name="project_id" required="0" readonly="contractor_quote_state in ('converted', 'declined', 'lost', 'cancelled')"/>
                <field name="parent_quote_id" readonly="1" invisible="not parent_quote_id"/>
            </xpath>

            <!-- Lock native SO order_line UI once confirmed, converted, or post-approval -->
            <xpath expr="//page[@name='order_lines']//field[@name='order_line']" position="attributes">
                <attribute name="readonly">state in ('sale', 'done', 'cancel') or locked or contractor_quote_state in ('approved_pending_release', 'sent_to_client', 'accepted', 'converted', 'declined', 'lost', 'cancelled')</attribute>
            </xpath>

            <!-- Dedicated 4-Block Cost Estimation Notebook Page -->
            <xpath expr="//page[@name='order_lines']" position="before">
                <page string="4-Block Cost Estimation &amp; Margins" name="page_cost_estimation">
                    
                    <!-- Consolidated Estimation Summary Bar -->
                    <div class="row bg-light p-3 border rounded mb-3">
                        <div class="col-md-3">
                            <span class="text-muted d-block">Direct &amp; Indirect Cost</span>
                            <h4 class="text-primary mb-0">
                                <field name="total_estimated_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </h4>
                        </div>
                        <div class="col-md-3" groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager">
                            <span class="text-muted d-block">Margin Mode / Value</span>
                            <div class="d-flex align-items-center">
                                <field name="margin_type" class="oe_inline me-2" readonly="contractor_quote_state not in ('draft', 'submitted')"/>
                                <span class="fw-bold">
                                    <field name="effective_margin_pct" class="oe_inline"/>%
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3" groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager">
                            <span class="text-muted d-block">Commercial Margin</span>
                            <h4 class="text-success mb-0">
                                <field name="margin_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </h4>
                        </div>
                        <div class="col-md-3" groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager">
                            <span class="text-muted d-block">Proposed Selling Value</span>
                            <h3 class="text-dark mb-0">
                                <field name="proposed_quotation_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </h3>
                        </div>
                    </div>

                    <!-- Margin Inputs -->
                    <group string="Margin Configuration" groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_manager">
                        <group>
                            <field name="margin_percent" invisible="margin_type != 'percentage'" readonly="contractor_quote_state not in ('draft', 'submitted')"/>
                            <field name="margin_amount" invisible="margin_type != 'fixed'" readonly="contractor_quote_state not in ('draft', 'submitted')"/>
                        </group>
                        <group>
                            <field name="margin_override_approved" readonly="1"/>
                            <field name="margin_override_reason" readonly="1" invisible="not margin_override_approved"/>
                        </group>
                    </group>

                    <!-- Block 1: Labor Cost Estimation -->
                    <div class="mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h5 class="mb-0 text-primary">Block 1: Labor Cost Estimation</h5>
                            <span class="badge bg-primary fs-6">
                                Subtotal: <field name="total_labour_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </span>
                        </div>
                        <field name="est_labour_line_ids" readonly="contractor_quote_state not in ('draft', 'submitted')">
                            <list editable="bottom" string="Labor Estimation Lines">
                                <field name="worker_category"/>
                                <field name="employee_id" optional="show"/>
                                <field name="trade"/>
                                <field name="role_designation"/>
                                <field name="calculation_mode"/>
                                <field name="estimated_hours" invisible="calculation_mode != 'hours_rate'"/>
                                <field name="hourly_cost_rate" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="calculation_mode != 'hours_rate'"/>
                                <field name="direct_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="calculation_mode != 'direct_amount'"/>
                                <field name="subtotal_cost" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Labor"/>
                                <field name="currency_id" invisible="1"/>
                            </list>
                        </field>
                    </div>

                    <!-- Block 2: Material Cost Estimation -->
                    <div class="mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h5 class="mb-0 text-primary">Block 2: Material Cost Estimation</h5>
                            <span class="badge bg-primary fs-6">
                                Subtotal: <field name="total_material_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </span>
                        </div>
                        <div class="alert alert-warning py-2 mb-2" role="alert" invisible="not has_missing_new_sku_cost_basis">
                            <strong>New-SKU Cost Basis Notice:</strong> One or more non-catalog New SKU items have an empty Cost Basis Justification. Manager review will be flagged upon submission.
                        </div>
                        <field name="est_material_line_ids" readonly="contractor_quote_state not in ('draft', 'submitted')">
                            <list editable="bottom" string="Material Estimation Lines" decoration-warning="missing_cost_basis">
                                <field name="missing_cost_basis" column_invisible="1"/>
                                <field name="is_new_sku"/>
                                <field name="product_id" required="not is_new_sku" invisible="is_new_sku"/>
                                <field name="item_description"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                                <field name="historical_avg_cost" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="is_new_sku"/>
                                <field name="manual_unit_cost" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not is_new_sku" required="is_new_sku"/>
                                <field name="cost_basis_reason" invisible="not is_new_sku" required="is_new_sku" decoration-warning="is_new_sku and not cost_basis_reason"/>
                                <field name="subtotal_cost" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Material"/>
                                <field name="currency_id" invisible="1"/>
                            </list>
                        </field>
                    </div>

                    <!-- Block 3: Legal & Permits -->
                    <div class="mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h5 class="mb-0 text-primary">Block 3: Legal, Permits &amp; Statutory Fees</h5>
                            <span class="badge bg-primary fs-6">
                                Subtotal: <field name="total_legal_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </span>
                        </div>
                        <field name="est_legal_line_ids" readonly="contractor_quote_state not in ('draft', 'submitted')">
                            <list editable="bottom" string="Legal &amp; Permits Lines">
                                <field name="fee_category"/>
                                <field name="description"/>
                                <field name="issuing_authority"/>
                                <field name="estimated_cost" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Legal"/>
                                <field name="currency_id" invisible="1"/>
                            </list>
                        </field>
                    </div>

                    <!-- Block 4: Miscellaneous & Site Expenses -->
                    <div class="mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h5 class="mb-0 text-primary">Block 4: Miscellaneous &amp; Site Indirects</h5>
                            <span class="badge bg-primary fs-6">
                                Subtotal: <field name="total_misc_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </span>
                        </div>
                        <field name="est_misc_line_ids" readonly="contractor_quote_state not in ('draft', 'submitted')">
                            <list editable="bottom" string="Miscellaneous &amp; Indirects Lines">
                                <field name="misc_category"/>
                                <field name="description"/>
                                <field name="estimated_cost" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Misc"/>
                                <field name="currency_id" invisible="1"/>
                            </list>
                        </field>
                    </div>

                </page>
            </xpath>

            <!-- Customer Acceptance & Project Conversion Page -->
            <xpath expr="//page[@name='other_information']" position="before">
                <page string="Customer Acceptance Gate" name="page_acceptance"
                      groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_project_manager,contractor_core.group_contractor_manager">
                    <group string="Client Sign-Off &amp; Contract Verification">
                        <group>
                            <field name="acceptance_doc_type" readonly="contractor_quote_state == 'converted'"/>
                            <field name="acceptance_ref" readonly="contractor_quote_state == 'converted'"/>
                            <field name="acceptance_date" readonly="contractor_quote_state == 'converted'"/>
                        </group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="project_budget_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Mandatory Client Signed Attachments">
                        <field name="acceptance_document_ids" widget="many2many_binary" string="Client Signed Documents (LPO, Contract, Quote)" readonly="contractor_quote_state == 'converted'"/>
                    </group>
                </page>

                <!-- Document Governance & Version Snapshots Page -->
                <page string="Governance Audit &amp; Versions" name="page_governance_audit">
                    <group string="Estimation Audit Timestamps">
                        <group>
                            <field name="original_engineer_id" widget="many2one_avatar_user"/>
                            <field name="submitted_date"/>
                            <field name="approved_date"/>
                        </group>
                        <group>
                            <field name="client_dispatch_datetime"/>
                            <field name="version_number"/>
                            <field name="non_conversion_updated_date" invisible="not non_conversion_updated_date"/>
                            <field name="non_conversion_reason" invisible="not non_conversion_reason"/>
                            <field name="has_new_sku_cost_lines" invisible="1"/>
                        </group>
                    </group>
                    <group string="Immutable Version Snapshots (v1, v2, v3...)">
                        <field name="version_history_ids" readonly="1" nolabel="1" colspan="2">
                            <list string="Snapshots" create="0" delete="0" edit="0">
                                <field name="version_number" decoration-bf="1"/>
                                <field name="name"/>
                                <field name="timestamp"/>
                                <field name="editor_id"/>
                                <field name="reason"/>
                                <field name="total_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="margin" widget="percentage"/>
                                <field name="attachment_count" string="Attachments"/>
                                <field name="currency_id" invisible="1"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Base List View Extension (Applies to All Quotations & Sales Orders Lists) -->
    <record id="view_order_tree_inherit_contractor" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.contractor</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="version_number" string="Rev" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="lead_id" optional="show"/>
                <field name="project_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="total_estimated_cost" string="Est. Cost" widget="monetary" optional="show"/>
                <field name="effective_margin_pct" string="Margin %" optional="show"
                       groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager"/>
                <field name="proposed_quotation_value" string="Proposed Value" widget="monetary" optional="hide"
                       groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="contractor_quote_state"
                       string="Quotation Status"
                       widget="badge"
                       decoration-info="contractor_quote_state == 'draft'"
                       decoration-warning="contractor_quote_state in ('submitted', 'approved_pending_release', 'under_negotiation')"
                       decoration-primary="contractor_quote_state in ('sent_to_client', 'accepted')"
                       decoration-success="contractor_quote_state == 'converted'"
                       decoration-danger="contractor_quote_state in ('declined', 'lost', 'cancelled')"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide redundant Odoo core 'state' by default on Quotations List too -->
    <record id="view_quotation_tree_inherit_contractor_hide_state" model="ir.ui.view">
        <field name="name">sale.quotation.list.inherit.contractor.hide.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Kanban View Extension -->
    <record id="view_sale_order_kanban_inherit_contractor" model="ir.ui.view">
        <field name="name">sale.order.kanban.inherit.contractor</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="project_id"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" invisible="1"/>
                <field name="contractor_quote_state"
                       widget="label_selection"
                       options="{'classes': {'draft': 'info', 'submitted': 'warning', 'approved_pending_release': 'warning', 'sent_to_client': 'primary', 'under_negotiation': 'warning', 'accepted': 'primary', 'converted': 'success', 'declined': 'danger', 'lost': 'danger', 'cancelled': 'danger'}}"
                       class="ms-auto"/>
            </xpath>
        </field>
    </record>

    <!-- Search View Extension (Applies to Quotations, Orders, Approvals & Follow-ups) -->
    <record id="view_sales_order_filter_inherit_contractor" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.contractor</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="lead_id"/>
                <field name="project_id"/>
            </xpath>
            <xpath expr="//filter[@name='activities_upcoming_all']" position="after">
                <separator/>
                <filter string="Draft Estimation" name="filter_draft_est" domain="[('contractor_quote_state', '=', 'draft')]"/>
                <filter string="Pending Approvals" name="filter_pending_approvals" domain="[('contractor_quote_state', 'in', ('submitted', 'approved_pending_release'))]"/>
                <filter string="Submitted for Manager Review" name="filter_submitted" domain="[('contractor_quote_state', '=', 'submitted')]"/>
                <filter string="Approved - Pending Release" name="filter_pending_release" domain="[('contractor_quote_state', '=', 'approved_pending_release')]"/>
                <filter string="Active Follow-ups" name="filter_active_followups" domain="[('contractor_quote_state', 'in', ('sent_to_client', 'under_negotiation', 'accepted'))]"/>
                <filter string="Sent to Client" name="filter_sent_to_client" domain="[('contractor_quote_state', '=', 'sent_to_client')]"/>
                <filter string="Under Negotiation" name="filter_negotiation" domain="[('contractor_quote_state', '=', 'under_negotiation')]"/>
                <filter string="Customer Accepted" name="filter_accepted" domain="[('contractor_quote_state', '=', 'accepted')]"/>
                <filter string="Converted to Active Project" name="filter_converted" domain="[('contractor_quote_state', '=', 'converted')]"/>
                <filter string="Cancelled / Lost / Declined" name="filter_closed_lost" domain="[('contractor_quote_state', 'in', ('cancelled', 'lost', 'declined'))]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Contractor Quotation Status" name="group_contractor_quote_state" domain="[]" context="{'group_by': 'contractor_quote_state'}"/>
                <filter string="Source Lead" name="group_lead" domain="[]" context="{'group_by': 'lead_id'}"/>
                <filter string="Project Code" name="group_project" domain="[]" context="{'group_by': 'project_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Dedicated Window Actions for Estimations, Approvals & Follow-ups -->
    <record id="action_contractor_quotations_all" model="ir.actions.act_window">
        <field name="name">Cost Estimates &amp; Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Cost Estimate &amp; Contracting Quotation
            </p>
            <p>
                Compile 4-block estimates (Labor, Material, Legal/Permits, Misc), submit for approval, and convert accepted quotes into active projects.
            </p>
        </field>
    </record>

    <record id="action_contractor_quotation_approvals" model="ir.actions.act_window">
        <field name="name">Quotation Approvals</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="domain">[('contractor_quote_state', 'in', ('submitted', 'approved_pending_release'))]</field>
        <field name="context">{'search_default_group_contractor_quote_state': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No quotations pending Manager Approval or Sales Release!
            </p>
        </field>
    </record>

    <record id="action_contractor_quotation_followups" model="ir.actions.act_window">
        <field name="name">Quotation Follow-ups</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="domain">[('contractor_quote_state', 'in', ('sent_to_client', 'under_negotiation', 'accepted'))]</field>
        <field name="context">{'search_default_group_contractor_quote_state': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No quotations currently open for client follow-up, negotiation, or project conversion!
            </p>
        </field>
    </record>
</odoo>

