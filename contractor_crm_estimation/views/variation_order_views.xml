<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Variation Order Form View -->
    <record id="view_contractor_variation_order_form" model="ir.ui.view">
        <field name="name">contractor.variation.order.form</field>
        <field name="model">contractor.variation.order</field>
        <field name="arch" type="xml">
            <form string="Scope Variation Order (VO)">
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit for Review"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_manager_approve"
                            type="object"
                            string="Manager Approve"
                            class="btn-success"
                            invisible="state != 'submitted' or requires_md_approval"
                            groups="contractor_core.group_contractor_manager"/>

                    <button name="action_md_approve"
                            type="object"
                            string="Managing Director Approve"
                            class="btn-danger"
                            invisible="state != 'submitted' or not requires_md_approval"
                            groups="contractor_core.group_contractor_md"/>

                    <button name="action_send_to_client"
                            type="object"
                            string="Send to Client"
                            class="btn-info"
                            invisible="state not in ('manager_approved', 'md_approved')"/>

                    <button name="action_client_accept"
                            type="object"
                            string="Record Client Acceptance"
                            class="btn-primary"
                            invisible="state != 'sent_to_client'"/>

                    <button name="action_integrate_vo"
                            type="object"
                            string="Integrate into Master Budget (VO Line)"
                            class="btn-success"
                            invisible="state != 'client_accepted'"/>

                    <button name="action_return_for_revision"
                            type="object"
                            string="Return for Revision"
                            class="btn-warning"
                            invisible="state not in ('submitted', 'manager_approved', 'md_approved', 'sent_to_client')"
                            groups="contractor_core.group_contractor_manager,contractor_core.group_contractor_md"/>

                    <button name="action_decline"
                            type="object"
                            string="Decline"
                            class="btn-secondary"
                            invisible="state in ('integrated', 'declined', 'withdrawn')"/>

                    <button name="action_withdraw"
                            type="object"
                            string="Withdraw"
                            class="btn-secondary"
                            invisible="state in ('integrated', 'declined', 'withdrawn')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,sent_to_client,client_accepted,integrated"/>
                </header>
                <sheet>
                    <div class="alert alert-danger py-2 mb-2" role="alert" invisible="not requires_md_approval or state not in ('submitted', 'draft')">
                        <strong>Executive Governance Gate:</strong>
                        This Variation Order exceeds the company MD threshold or cumulative contract trigger ratio (Cumulative Ratio: <field name="cumulative_vo_ratio" class="oe_inline"/>%).
                        Managing Director approval is strictly required.
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Variation Order Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Project &amp; Contract Context">
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="order_id" readonly="1"/>
                            <field name="reason_type" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Schedule &amp; Financial Scope">
                            <field name="timeline_impact_days" readonly="state != 'draft'"/>
                            <field name="total_estimated_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_vo_value" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_subtotal_footer_separator"/>
                            <field name="requires_md_approval" invisible="1"/>
                        </group>
                    </group>

                    <group string="Scope Narrative">
                        <field name="scope_description" placeholder="Describe the detailed technical scope, architectural change, or unforeseen site condition..." nolabel="1" colspan="2" readonly="state not in ('draft', 'submitted')"/>
                    </group>

                    <notebook>
                        <page string="4-Block Cost Estimation" name="page_vo_estimation">
                            <div class="row bg-light p-3 border rounded mb-3">
                                <div class="col-md-3">
                                    <span class="text-muted d-block">VO Direct Cost</span>
                                    <h4 class="text-primary mb-0">
                                        <field name="total_estimated_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </h4>
                                </div>
                                <div class="col-md-3" groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_project_manager,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager">
                                    <span class="text-muted d-block">Margin Mode / Value</span>
                                    <div class="d-flex align-items-center">
                                        <field name="margin_type" class="oe_inline me-2" readonly="state not in ('draft', 'submitted')"/>
                                        <field name="margin_percent" invisible="margin_type != 'percentage'" class="oe_inline" readonly="state not in ('draft', 'submitted')"/>
                                        <field name="margin_amount" invisible="margin_type != 'fixed'" class="oe_inline" readonly="state not in ('draft', 'submitted')"/>
                                    </div>
                                </div>
                                <div class="col-md-3" groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_project_manager,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager">
                                    <span class="text-muted d-block">Margin Amount</span>
                                    <h4 class="text-success mb-0">
                                        <field name="margin_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </h4>
                                </div>
                                <div class="col-md-3" groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_project_manager,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager">
                                    <span class="text-muted d-block">Billable VO Value</span>
                                    <h3 class="text-dark mb-0">
                                        <field name="total_vo_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </h3>
                                </div>
                            </div>

                            <!-- Block 1: Labor -->
                            <div class="mt-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="mb-0 text-primary">Block 1: Labor Cost</h6>
                                    <span class="badge bg-primary">
                                        Subtotal: <field name="total_labour_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </span>
                                </div>
                                <field name="est_labour_line_ids" readonly="state not in ('draft', 'submitted')">
                                    <list editable="bottom">
                                        <field name="worker_category"/>
                                        <field name="employee_id" optional="show"/>
                                        <field name="trade"/>
                                        <field name="role_designation"/>
                                        <field name="calculation_mode"/>
                                        <field name="estimated_hours" invisible="calculation_mode != 'hours_rate'"/>
                                        <field name="hourly_cost_rate" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="calculation_mode != 'hours_rate'"/>
                                        <field name="direct_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="calculation_mode != 'direct_amount'"/>
                                        <field name="subtotal_cost" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Labor"/>
                                        <field name="currency_id" invisible="1"/>
                                    </list>
                                </field>
                            </div>

                            <!-- Block 2: Material -->
                            <div class="mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="mb-0 text-primary">Block 2: Material Cost</h6>
                                    <span class="badge bg-primary">
                                        Subtotal: <field name="total_material_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </span>
                                </div>
                                <field name="est_material_line_ids" readonly="state not in ('draft', 'submitted')">
                                    <list editable="bottom">
                                        <field name="is_new_sku"/>
                                        <field name="product_id" required="not is_new_sku" invisible="is_new_sku"/>
                                        <field name="item_description"/>
                                        <field name="quantity"/>
                                        <field name="uom_id"/>
                                        <field name="historical_avg_cost" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="is_new_sku"/>
                                        <field name="manual_unit_cost" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not is_new_sku" required="is_new_sku"/>
                                        <field name="cost_basis_reason" invisible="not is_new_sku" required="is_new_sku"/>
                                        <field name="subtotal_cost" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Material"/>
                                        <field name="currency_id" invisible="1"/>
                                    </list>
                                </field>
                            </div>

                            <!-- Block 3: Legal -->
                            <div class="mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="mb-0 text-primary">Block 3: Legal &amp; Permits</h6>
                                    <span class="badge bg-primary">
                                        Subtotal: <field name="total_legal_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </span>
                                </div>
                                <field name="est_legal_line_ids" readonly="state not in ('draft', 'submitted')">
                                    <list editable="bottom">
                                        <field name="fee_category"/>
                                        <field name="description"/>
                                        <field name="issuing_authority"/>
                                        <field name="estimated_cost" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Legal"/>
                                        <field name="currency_id" invisible="1"/>
                                    </list>
                                </field>
                            </div>

                            <!-- Block 4: Misc -->
                            <div class="mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="mb-0 text-primary">Block 4: Miscellaneous &amp; Indirects</h6>
                                    <span class="badge bg-primary">
                                        Subtotal: <field name="total_misc_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </span>
                                </div>
                                <field name="est_misc_line_ids" readonly="state not in ('draft', 'submitted')">
                                    <list editable="bottom">
                                        <field name="misc_category"/>
                                        <field name="description"/>
                                        <field name="estimated_cost" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Misc"/>
                                        <field name="currency_id" invisible="1"/>
                                    </list>
                                </field>
                            </div>
                        </page>

                        <page string="Client Acceptance Gate" name="page_vo_acceptance"
                              groups="contractor_core.group_contractor_sales_admin,contractor_core.group_contractor_project_manager,contractor_core.group_contractor_manager">
                            <div class="alert alert-warning py-2 mb-2" role="alert">
                                <strong>Integration Gate Hard-Stop:</strong>
                                Budget integration into the project master budget is strictly blocked until client signed acceptance documents (Signed VO form, LPO, Addendum) are attached below.
                            </div>
                            <group>
                                <field name="client_acceptance_ref" readonly="state == 'integrated'"/>
                                <field name="client_acceptance_date" readonly="state == 'integrated'"/>
                            </group>
                            <group string="Mandatory Client Signed Attachments">
                                <field name="client_acceptance_attachment_ids" widget="many2many_binary" string="Client Acceptance Documents" readonly="state == 'integrated'"/>
                            </group>
                        </page>

                        <page string="Version Snapshots &amp; Audit" name="page_vo_versions">
                            <group>
                                <field name="approval_date" readonly="1"/>
                                <field name="version_number" readonly="1"/>
                            </group>
                            <field name="version_history_ids" readonly="1">
                                <list string="Snapshots" create="0" delete="0" edit="0">
                                    <field name="version_number"/>
                                    <field name="name"/>
                                    <field name="timestamp"/>
                                    <field name="editor_id"/>
                                    <field name="reason"/>
                                    <field name="total_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Variation Order List View -->
    <record id="view_contractor_variation_order_list" model="ir.ui.view">
        <field name="name">contractor.variation.order.list</field>
        <field name="model">contractor.variation.order</field>
        <field name="arch" type="xml">
            <list string="Variation Orders" default_order="create_date desc" decoration-success="state == 'integrated'" decoration-info="state in ('manager_approved', 'md_approved', 'client_accepted')" decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="reason_type"/>
                <field name="total_estimated_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="total_vo_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="timeline_impact_days"/>
                <field name="requires_md_approval"/>
                <field name="state" widget="badge" decoration-success="state == 'integrated'" decoration-info="state in ('manager_approved', 'md_approved', 'client_accepted')" decoration-warning="state == 'submitted'" decoration-danger="state == 'declined'"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_contractor_variation_order_search" model="ir.ui.view">
        <field name="name">contractor.variation.order.search</field>
        <field name="model">contractor.variation.order</field>
        <field name="arch" type="xml">
            <search string="Search Variation Orders">
                <field name="name"/>
                <field name="project_id"/>
                <field name="order_id"/>
                <field name="reason_type"/>
                <filter string="Pending Approval" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="MD Approval Required" name="filter_md_required" domain="[('requires_md_approval', '=', True)]"/>
                <filter string="Integrated to Budget" name="filter_integrated" domain="[('state', '=', 'integrated')]"/>
                <group>
                    <filter string="Project" name="group_project" domain="[]" context="{'group_by': 'project_id'}"/>
                    <filter string="Reason Type" name="group_reason_type" domain="[]" context="{'group_by': 'reason_type'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot & Graph Views -->
    <record id="view_contractor_variation_order_pivot" model="ir.ui.view">
        <field name="name">contractor.variation.order.pivot</field>
        <field name="model">contractor.variation.order</field>
        <field name="arch" type="xml">
            <pivot string="Variation Orders Analysis">
                <field name="project_id" type="row"/>
                <field name="state" type="col"/>
                <field name="total_estimated_cost" type="measure"/>
                <field name="margin_amount" type="measure"/>
                <field name="total_vo_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_contractor_variation_order_graph" model="ir.ui.view">
        <field name="name">contractor.variation.order.graph</field>
        <field name="model">contractor.variation.order</field>
        <field name="arch" type="xml">
            <graph string="Variation Orders Value by Project" type="bar">
                <field name="project_id"/>
                <field name="total_vo_value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_contractor_variation_order" model="ir.actions.act_window">
        <field name="name">Variation Orders (VO)</field>
        <field name="res_model">contractor.variation.order</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_contractor_variation_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No scope variation orders recorded yet.
            </p>
            <p>
                Manage scope modifications, architectural changes, and site condition claims.
                Integrate approved VOs directly into the project master budget as segregated, traceable line items.
            </p>
        </field>
    </record>
</odoo>

