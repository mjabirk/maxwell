<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_contractor" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.contractor</field>
        <field name="model">crm.lead</field>
        <field name="priority" eval="30"/>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Header Statusbar & Workflow Buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_create_cost_estimate"
                        type="object"
                        string="Create Cost Estimate"
                        class="btn-primary"
                        invisible="contractor_state in ('won', 'lost', 'declined') or not has_completed_site_visit"/>

                <button name="%(action_contractor_site_visit_new)d"
                        type="action"
                        string="Schedule Site Visit"
                        class="btn-secondary"
                        context="{'default_lead_id': id, 'default_partner_id': partner_id, 'default_assigned_engineer_id': assigned_engineer_id}"
                        invisible="contractor_state in ('won', 'lost', 'declined')"/>

                <button name="action_reopen_lead"
                        type="object"
                        string="Reopen Lead"
                        class="btn-warning"
                        invisible="contractor_state not in ('lost', 'on_hold', 'declined')"/>

                <button name="action_clear_fresh_cost_review"
                        type="object"
                        string="Attest Fresh Cost Review"
                        class="btn-success"
                        invisible="not requires_fresh_cost_review"
                        groups="contractor_core.group_contractor_manager"/>

                <button name="action_set_on_hold"
                        type="object"
                        string="Put On Hold"
                        class="btn-secondary"
                        invisible="contractor_state in ('on_hold', 'lost', 'declined', 'won')"/>

                <button name="action_set_lost"
                        type="object"
                        string="Mark as Lost"
                        class="btn-secondary"
                        invisible="contractor_state in ('lost', 'declined', 'won')"/>

                <button name="action_set_declined"
                        type="object"
                        string="Decline Inquiry"
                        class="btn-secondary"
                        invisible="contractor_state in ('lost', 'declined', 'won')"/>

                <field name="contractor_state" widget="statusbar" statusbar_visible="open,site_visit,quoted,sent_to_client,negotiation,won"/>
            </xpath>

            <!-- Stat Buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_site_visits" icon="fa-camera">
                    <field string="Site Visits" name="site_visit_count" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" type="object" name="action_view_contractor_orders" icon="fa-calculator">
                    <field string="Estimates" name="contractor_order_count" widget="statinfo"/>
                </button>
            </xpath>

            <!-- Alerts for Upload Gate & Fresh Review -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="not requires_fresh_cost_review">
                    <strong>Fresh Cost Review Required:</strong>
                    This lead was previously closed or placed on hold. Labor and material rates must be re-validated before submitting quotations.
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="has_completed_site_visit or contractor_state in ('won', 'lost', 'declined')">
                    <strong>Site Visit Upload Gate Active:</strong>
                    At least one Site Visit must be marked as <b>Completed</b> with field observations, measurements, photos, and drawings before a Cost Estimate can be generated.
                </div>
            </xpath>

            <!-- Core Fields Mandatory Enforcement & Grouping -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='contact_name']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

            <xpath expr="//group[@name='lead_partner']" position="after">
                <group string="Contractor Governance &amp; Assignment">
                    <field name="assigned_manager_id" options="{'no_create': True}"/>
                    <field name="assigned_engineer_id" widget="many2one_avatar_employee"/>
                    <field name="expected_project_type"/>
                    <field name="project_location"/>
                    <field name="enquiry_date" readonly="1"/>
                    <field name="source_id" required="1"/>
                    <field name="contractor_remarks"/>
                    <field name="has_completed_site_visit" invisible="1"/>
                    <field name="requires_fresh_cost_review" invisible="1"/>
                </group>
            </xpath>

            <!-- Notebook Page for Site Visits -->
            <xpath expr="//notebook" position="inside">
                <page string="Site Inspections &amp; Visits" name="page_site_visits">
                    <field name="site_visit_ids" context="{'default_lead_id': id}">
                        <list string="Site Visits" decoration-success="state == 'completed'" decoration-warning="state == 'draft'" decoration-muted="state == 'cancelled'">
                            <field name="name"/>
                            <field name="assigned_engineer_id" widget="many2one_avatar_employee"/>
                            <field name="scheduled_date"/>
                            <field name="completion_date"/>
                            <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-warning="state == 'draft'" decoration-danger="state == 'cancelled'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Filter & Search Views for Contractor CRM -->
    <record id="view_crm_lead_filter_inherit_contractor" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.contractor</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='assigned_to_me']" position="after">
                <filter string="Requires Site Visit" name="filter_needs_visit" domain="[('has_completed_site_visit', '=', False), ('contractor_state', 'in', ['open', 'site_visit'])]"/>
                <filter string="Site Visit Completed" name="filter_visit_done" domain="[('has_completed_site_visit', '=', True)]"/>
                <filter string="Requires Fresh Cost Review" name="filter_fresh_review" domain="[('requires_fresh_cost_review', '=', True)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Contractor Pipeline Status" name="group_contractor_state" domain="[]" context="{'group_by': 'contractor_state'}"/>
                <filter string="Assigned Estimating Manager" name="group_assigned_manager" domain="[]" context="{'group_by': 'assigned_manager_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>

