<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence for Site Visit -->
    <record id="seq_contractor_site_visit" model="ir.sequence">
        <field name="name">Contractor Site Visit Sequence</field>
        <field name="code">contractor.site.visit</field>
        <field name="prefix">SV-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Variation Order -->
    <record id="seq_contractor_variation_order" model="ir.sequence">
        <field name="name">Contractor Variation Order Sequence</field>
        <field name="code">contractor.variation.order</field>
        <field name="prefix">VO-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Project Code -->
    <record id="seq_contractor_project_code" model="ir.sequence">
        <field name="name">Contractor Project Code Sequence</field>
        <field name="code">contractor.project.code</field>
        <field name="prefix">PRJ-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

