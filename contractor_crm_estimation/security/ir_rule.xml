<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_contractor_site_visit_multi_company" model="ir.rule">
        <field name="name">Site Visit Multi-Company</field>
        <field name="model_id" ref="model_contractor_site_visit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

