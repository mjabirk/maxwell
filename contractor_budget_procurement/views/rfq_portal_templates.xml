<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rfq_portal_form" name="Vendor RFQ Portal Quotation Form">
        <t t-call="web.layout">
            <t t-set="title" t-value="'RFQ Quotation Portal - %s' % (invite.name or '')"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <style type="text/css">
                    body { background-color: #f4f6f9; color: #1f2937; }
                    .mx-rfq-banner { background: linear-gradient(135deg, #0f2a4a 0%, #1c416f 100%); color: #ffffff; border-bottom: 4px solid #c8963e; }
                    .mx-rfq-accent { color: #c8963e; }
                    .mx-rfq-card { border: 0; border-radius: 12px; box-shadow: 0 6px 24px rgba(15, 42, 74, 0.08); }
                    .mx-total-bar { background-color: #0f2a4a; color: #ffffff; border-radius: 8px; }
                </style>
            </t>
            <div class="mx-rfq-banner py-4 mb-4">
                <div class="container">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div>
                            <div class="text-uppercase small fw-semibold mx-rfq-accent">Maxwell Trading &amp; Contracting W.L.L — Supplier RFQ Portal</div>
                            <h1 class="h3 mb-1 text-white">Request for Quotation: <t t-out="invite.name"/></h1>
                            <div class="small text-white-50">
                                Issuing Entity: <strong class="text-white" t-out="company.name"/>
                                <t t-if="invite.project_id"> | Project: <strong class="text-white" t-out="invite.project_id.name"/></t>
                            </div>
                        </div>
                        <div class="text-md-end">
                            <span class="badge bg-light text-dark px-3 py-2 fs-6">
                                MR Ref: <t t-out="invite.requisition_id.name"/>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container pb-5">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card mx-rfq-card h-100">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">Invited Vendor</div>
                                <div class="fw-bold fs-5" t-out="invite.vendor_id.name"/>
                                <div class="small text-muted" t-if="invite.vendor_email" t-out="invite.vendor_email"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card mx-rfq-card h-100">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">Submission Deadline</div>
                                <div class="fw-bold fs-5">
                                    <t t-if="invite.deadline_date" t-out="invite.deadline_date"/>
                                    <t t-else="">Open Until Closed</t>
                                </div>
                                <div class="small text-muted">Currency: <strong t-out="currency.name"/> (<t t-out="currency.symbol"/>)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card mx-rfq-card h-100">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">Invitation Status</div>
                                <div class="mt-1">
                                    <span t-if="invite.state in ('draft', 'sent')" class="badge bg-primary fs-6">Open for Quotation</span>
                                    <span t-elif="invite.state == 'submitted'" class="badge bg-success fs-6">Quotation Received</span>
                                    <span t-elif="invite.state == 'approved'" class="badge bg-info text-dark fs-6">Approved / Synced to CS</span>
                                    <span t-else="" class="badge bg-secondary fs-6">Closed / Expired</span>
                                </div>
                                <div class="small text-muted mt-1" t-if="invite.submitted_datetime">
                                    Submitted: <t t-out="invite.submitted_datetime"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div t-if="error_message" class="alert alert-danger shadow-sm mb-4" role="alert">
                    <strong>Submission Error:</strong> <t t-out="error_message"/>
                </div>

                <t t-if="readonly_mode">
                    <div class="card mx-rfq-card mb-4">
                        <div class="card-header bg-white py-3">
                            <h2 class="h5 mb-0">Submitted Quotation Summary</h2>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info mb-4" role="status" t-if="invite.state in ('submitted', 'approved')">
                                Your quotation has been recorded and forwarded to Maxwell Trading &amp; Contracting W.L.L procurement for evaluation.
                                Contact Procurement if a revision link needs to be reopened.
                            </div>
                            <div class="alert alert-warning mb-4" role="alert" t-elif="invite.state == 'expired'">
                                This RFQ invitation has expired or been closed by Procurement.
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-sm-4">
                                    <div class="text-muted small">Vendor Quote Ref No.</div>
                                    <div class="fw-semibold" t-out="invite.vendor_reference or '-'"/>
                                </div>
                                <div class="col-sm-4">
                                    <div class="text-muted small">Delivery Lead Time</div>
                                    <div class="fw-semibold"><t t-out="invite.delivery_days"/> Day(s)</div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="text-muted small">Offered Payment Terms</div>
                                    <div class="fw-semibold" t-out="invite.payment_terms or '-'"/>
                                </div>
                            </div>

                            <div class="table-responsive mb-4">
                                <table class="table table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Material / Item</th>
                                            <th>Description</th>
                                            <th class="text-end">Qty</th>
                                            <th>UoM</th>
                                            <th class="text-end">Quoted Unit Price (<t t-out="currency.symbol"/>)</th>
                                            <th class="text-end">Subtotal (<t t-out="currency.symbol"/>)</th>
                                            <th>Brand / Spec Note</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="invite.line_ids" t-as="line">
                                            <td class="fw-semibold" t-out="line.product_id.display_name"/>
                                            <td t-out="line.description"/>
                                            <td class="text-end" t-out="'%.2f' % line.qty"/>
                                            <td t-out="line.product_uom_id.name"/>
                                            <td class="text-end" t-out="'%.2f' % line.quoted_price"/>
                                            <td class="text-end fw-bold" t-out="'%.2f' % line.subtotal"/>
                                            <td t-out="line.vendor_line_note or '-'"/>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-primary">
                                            <th colspan="5" class="text-end">Total Quoted Amount (<t t-out="currency.name"/>)</th>
                                            <th class="text-end fs-5" t-out="'%s %.2f' % (currency.symbol or '', invite.total_quoted_amount)"/>
                                            <th></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="mb-3" t-if="invite.vendor_notes">
                                <div class="text-muted small">Commercial Remarks</div>
                                <div class="p-3 bg-light rounded" t-out="invite.vendor_notes"/>
                            </div>

                            <div t-if="attachment_links">
                                <div class="text-muted small mb-2">Attached Quotation Files</div>
                                <ul class="list-group">
                                    <li class="list-group-item d-flex justify-content-between align-items-center" t-foreach="attachment_links" t-as="att">
                                        <span><i class="fa fa-file-pdf-o text-danger me-2"/><t t-out="att['name']"/></span>
                                        <a class="btn btn-sm btn-outline-primary" t-att-href="att['url']" target="_blank">Download</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </t>

                <t t-else="">
                    <form method="POST"
                          t-attf-action="/rfq/quote/#{invite.id}/#{invite.access_token}/submit"
                          enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="card mx-rfq-card mb-4">
                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                <h2 class="h5 mb-0">1. Itemized Pricing Schedule</h2>
                                <span class="small text-muted">Enter your unit price per item in <strong t-out="currency.name"/></span>
                            </div>
                            <div class="card-body p-0 p-md-3">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" id="rfq-items-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="min-width: 180px;">Product / Material</th>
                                                <th style="min-width: 180px;">Description</th>
                                                <th class="text-end">Qty</th>
                                                <th>UoM</th>
                                                <th style="min-width: 140px;" class="text-end">Unit Price (<t t-out="currency.symbol"/>)</th>
                                                <th style="min-width: 130px;" class="text-end">Subtotal</th>
                                                <th style="min-width: 180px;">Brand / Spec Note</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="invite.line_ids" t-as="line">
                                                <t t-set="saved_input" t-value="line_inputs.get(line.id, {})"/>
                                                <tr class="rfq-line-row">
                                                    <td class="fw-semibold" t-out="line.product_id.display_name"/>
                                                    <td class="small text-muted" t-out="line.description"/>
                                                    <td class="text-end fw-semibold" t-out="'%.2f' % line.qty"/>
                                                    <td t-out="line.product_uom_id.name"/>
                                                    <td>
                                                        <input type="number"
                                                               step="0.01"
                                                               min="0"
                                                               required="required"
                                                               class="form-control text-end rfq-unit-price"
                                                               t-attf-name="unit_price_#{line.id}"
                                                               t-att-data-qty="line.qty"
                                                               t-att-data-line-id="line.id"
                                                               t-att-value="saved_input.get('price', 0.0)"/>
                                                    </td>
                                                    <td class="text-end fw-bold rfq-line-subtotal" t-attf-id="subtotal_#{line.id}">
                                                        <t t-out="'%.2f' % saved_input.get('subtotal', 0.0)"/>
                                                    </td>
                                                    <td>
                                                        <input type="text"
                                                               class="form-control form-control-sm"
                                                               placeholder="Brand / origin / note"
                                                               t-attf-name="note_#{line.id}"
                                                               t-att-value="saved_input.get('note', '')"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="card-footer bg-white py-3">
                                <div class="mx-total-bar p-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                    <span class="fw-semibold text-uppercase">Grand Total Quoted Value (<t t-out="currency.name"/>)</span>
                                    <span class="fs-4 fw-bold mx-rfq-accent">
                                        <span t-out="currency.symbol or ''"/> <span id="rfq-grand-total">0.00</span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card mx-rfq-card mb-4">
                            <div class="card-header bg-white py-3">
                                <h2 class="h5 mb-0">2. Commercial Terms &amp; Signed Quotation Attachment</h2>
                            </div>
                            <div class="card-body">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold" for="vendor_reference">Vendor Quote Ref No.</label>
                                        <input type="text" class="form-control" id="vendor_reference" name="vendor_reference"
                                               placeholder="e.g. QTN-2026-089" t-att-value="vendor_reference"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold" for="delivery_days">Delivery Lead Time (Days) <span class="text-danger">*</span></label>
                                        <input type="number" min="0" step="1" required="required" class="form-control" id="delivery_days"
                                               name="delivery_days" t-att-value="delivery_days"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold" for="payment_terms">Payment Terms <span class="text-danger">*</span></label>
                                        <input type="text" required="required" class="form-control" id="payment_terms"
                                               name="payment_terms" t-att-value="payment_terms"/>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="vendor_notes">Vendor Commercial Remarks / Validity</label>
                                    <textarea class="form-control" id="vendor_notes" name="vendor_notes" rows="3"
                                              placeholder="Specify quotation validity period, warranty, or delivery conditions..."><t t-out="vendor_notes"/></textarea>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label fw-semibold" for="quotation_file">
                                        Attach Signed &amp; Stamped Official Quotation (PDF / Image / Excel / Word) <span class="text-danger">*</span>
                                    </label>
                                    <input type="file"
                                           class="form-control"
                                           id="quotation_file"
                                           name="quotation_file"
                                           accept=".pdf,image/*,.xlsx,.xls,.doc,.docx"
                                           multiple="multiple"
                                           required="required"/>
                                    <div class="form-text">Mandatory: Please attach your signed quotation PDF or scanned image before submitting.</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-lg btn-success px-5 fw-semibold shadow-sm">
                                Submit Official Quotation
                            </button>
                        </div>
                    </form>

                    <script type="text/javascript">
// <![CDATA[
(function () {
    function recalcTotals() {
        var inputs = document.querySelectorAll('.rfq-unit-price');
        var grandTotal = 0.0;
        for (var i = 0; i < inputs.length; i++) {
            var input = inputs[i];
            var qty = parseFloat(input.getAttribute('data-qty')) || 0.0;
            var price = parseFloat(input.value) || 0.0;
            var sub = qty * price;
            grandTotal += sub;
            var lineId = input.getAttribute('data-line-id');
            var cell = document.getElementById('subtotal_' + lineId);
            if (cell) {
                cell.textContent = sub.toFixed(2);
            }
        }
        var grandEl = document.getElementById('rfq-grand-total');
        if (grandEl) {
            grandEl.textContent = grandTotal.toFixed(2);
        }
    }
    document.addEventListener('DOMContentLoaded', function () {
        var inputs = document.querySelectorAll('.rfq-unit-price');
        for (var i = 0; i < inputs.length; i++) {
            inputs[i].addEventListener('input', recalcTotals);
            inputs[i].addEventListener('change', recalcTotals);
        }
        recalcTotals();
    });
})();
// ]]>
                    </script>
                </t>
            </div>
        </t>
    </template>

    <template id="rfq_portal_thank_you" name="Vendor RFQ Portal Thank You">
        <t t-call="web.layout">
            <t t-set="title" t-value="'Quotation Submitted - %s' % (invite.name or '')"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <style type="text/css">
                    body { background-color: #f4f6f9; color: #1f2937; }
                    .mx-rfq-banner { background: linear-gradient(135deg, #0f2a4a 0%, #1c416f 100%); color: #ffffff; border-bottom: 4px solid #c8963e; }
                    .mx-rfq-card { border: 0; border-radius: 12px; box-shadow: 0 6px 24px rgba(15, 42, 74, 0.08); }
                </style>
            </t>
            <div class="mx-rfq-banner py-4 mb-5">
                <div class="container">
                    <div class="text-uppercase small fw-semibold" style="color:#c8963e;">Maxwell Trading &amp; Contracting W.L.L — Supplier RFQ Portal</div>
                    <h1 class="h3 mb-0 text-white">Quotation Confirmation: <t t-out="invite.name"/></h1>
                </div>
            </div>
            <div class="container pb-5">
                <div class="card mx-rfq-card mx-auto" style="max-width: 720px;">
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="display-5 text-success mb-3"><i class="fa fa-check-circle"/></div>
                        <h2 class="h4 fw-bold mb-2">Thank You! Your Quotation Has Been Submitted</h2>
                        <p class="text-muted mb-4">
                            We have received your commercial bid and attached document(s) for Material Requisition
                            <strong t-out="invite.requisition_id.name"/>.
                        </p>
                        <div class="table-responsive text-start mb-4">
                            <table class="table table-bordered mb-0">
                                <tbody>
                                    <tr>
                                        <th class="bg-light">RFQ Reference</th>
                                        <td t-out="invite.name"/>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Vendor</th>
                                        <td t-out="invite.vendor_id.name"/>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Vendor Quote Ref</th>
                                        <td t-out="invite.vendor_reference or '-'"/>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Total Quoted Value</th>
                                        <td class="fw-bold" t-out="'%s %.2f' % (currency.symbol or '', invite.total_quoted_amount)"/>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Delivery / Payment Terms</th>
                                        <td><t t-out="invite.delivery_days"/> Days | <t t-out="invite.payment_terms"/></td>
                                    </tr>
                                    <tr t-if="uploaded_names">
                                        <th class="bg-light">Uploaded Files</th>
                                        <td t-out="', '.join(uploaded_names)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <a class="btn btn-primary px-4" t-attf-href="/rfq/quote/#{invite.id}/#{invite.access_token}">
                            View Read-Only Quotation Summary
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
