<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contractor_material_requisition_form" model="ir.ui.view">
        <field name="name">contractor.material.requisition.form</field>
        <field name="model">contractor.material.requisition</field>
        <field name="arch" type="xml">
            <form string="Material Requisition (MR)">
                <header>
                    <button name="action_submit"
                            string="Submit for Approval"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_manager_approve"
                            string="Manager Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="contractor_core.group_contractor_manager"/>
                    <button name="action_create_comparative_statement"
                            string="Create Comparative Statement (RFQ Matrix)"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('approved', 'cs_in_progress')"/>
                    <button name="action_open_send_rfq_wizard"
                            string="Send RFQ to Vendors (Portal)"
                            type="object"
                            class="btn-info"
                            invisible="state not in ('approved', 'cs_in_progress')"
                            groups="contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_manager"/>
                    <button name="action_create_direct_po"
                            string="Create Direct PO (Below RFQ Threshold)"
                            type="object"
                            class="btn-info"
                            invisible="state != 'approved' or not is_below_rfq_threshold"
                            groups="contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_manager"/>
                    <button name="action_revise_mr"
                            string="Revise &amp; Resubmit (New Version)"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'declined'"/>
                    <button name="action_decline"
                            string="Decline"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ('submitted', 'approved')"
                            groups="contractor_core.group_contractor_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,cs_in_progress,po_created,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rfq_invites"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-envelope-open-o"
                                invisible="rfq_invite_count == 0">
                            <field name="rfq_invite_count" widget="statinfo" string="Vendor Quotes"/>
                        </button>
                        <button name="action_view_comparative_statements"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-balance-scale"
                                invisible="comparative_statement_count == 0">
                            <field name="comparative_statement_count" widget="statinfo" string="Bid Matrices"/>
                        </button>
                        <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-credit-card"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                    </div>

                    <!-- 24h SLA Escalation Warning Banner -->
                    <div class="alert alert-danger py-2 mb-3" role="alert" invisible="not escalated_to_md">
                        <strong>24-Hour SLA Escalation Triggered:</strong>
                        This requisition has been pending approval beyond the company SLA and is escalated directly to the Managing Director.
                    </div>

                    <!-- Budget Warning Banner -->
                    <div class="alert alert-warning py-2 mb-3" role="alert" invisible="budget_healthy"
                         groups="contractor_core.group_contractor_project_manager,contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager">
                        <strong>Budget Overrun Warning:</strong>
                        Requisition value exceeds remaining project material budget (<field name="remaining_material_budget" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" class="oe_inline"/>).
                        An approved management override is required to finalize procurement.
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Requisition Number"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Project &amp; Schedule">
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="required_date" readonly="state != 'draft'"/>
                            <field name="requested_by"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="budget_healthy" invisible="1"/>
                        </group>
                        <group string="Governance &amp; Stock Gate">
                            <field name="stock_checked" widget="boolean_toggle" readonly="state != 'draft'"/>
                            <field name="remaining_material_budget" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"
                                   groups="contractor_core.group_contractor_project_manager,contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager"/>
                            <field name="submitted_datetime" readonly="1" invisible="not submitted_datetime"/>
                            <field name="escalated_to_md" readonly="1" invisible="not escalated_to_md"/>
                            <field name="approver_id" readonly="1" invisible="not approver_id"/>
                            <field name="approval_datetime" readonly="1" invisible="not approval_datetime"/>
                            <field name="is_below_rfq_threshold" invisible="1"/>
                            <field name="preferred_vendor_id" invisible="not is_below_rfq_threshold" readonly="state not in ('draft', 'submitted', 'approved')"/>
                        </group>
                    </group>

                    <group string="Usage Purpose &amp; Supporting Documents">
                        <field name="purpose" placeholder="Describe the milestone, structural zone, or task where materials are required..." readonly="state != 'draft'"/>
                        <field name="supporting_attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                    </group>

                    <notebook>
                        <page string="Requested Material Lines" name="page_lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list string="Items" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="on_hand_qty" readonly="1"/>
                                    <field name="net_available_qty" readonly="1" decoration-bf="1"/>
                                    <field name="estimated_unit_cost" widget="monetary" options="{'currency_field': 'currency_id'}"
                                           groups="contractor_core.group_contractor_project_manager,contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager"/>
                                    <field name="estimated_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Est."
                                           groups="contractor_core.group_contractor_project_manager,contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager"/>
                                    <field name="ordered_qty" readonly="1"/>
                                    <field name="received_qty" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right"
                                   groups="contractor_core.group_contractor_project_manager,contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager">
                                <field name="total_estimated_amount" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Version History" name="page_mr_versions">
                            <field name="version_number" readonly="1"/>
                            <field name="version_history_ids" readonly="1">
                                <list string="Archived Versions" create="0" delete="0" edit="0">
                                    <field name="version_number"/>
                                    <field name="name"/>
                                    <field name="timestamp"/>
                                    <field name="editor_id"/>
                                    <field name="reason"/>
                                    <field name="total_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="attachment_count" string="Attachments"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_contractor_material_requisition_list" model="ir.ui.view">
        <field name="name">contractor.material.requisition.list</field>
        <field name="model">contractor.material.requisition</field>
        <field name="arch" type="xml">
            <list string="Material Requisitions" default_order="create_date desc">
                <field name="name"/>
                <field name="project_id"/>
                <field name="required_date"/>
                <field name="stock_checked" widget="boolean"/>
                <field name="total_estimated_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Value"
                       groups="contractor_core.group_contractor_project_manager,contractor_core.group_contractor_procurement_officer,contractor_core.group_contractor_accountant,contractor_core.group_contractor_manager"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in ('approved', 'cs_in_progress', 'po_created', 'done')"
                       decoration-danger="state == 'declined'"/>
                <field name="escalated_to_md" widget="badge" decoration-danger="escalated_to_md" invisible="not escalated_to_md"/>
                <field name="submitted_datetime"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_contractor_material_requisition_search" model="ir.ui.view">
        <field name="name">contractor.material.requisition.search</field>
        <field name="model">contractor.material.requisition</field>
        <field name="arch" type="xml">
            <search string="Search Material Requisitions">
                <field name="name"/>
                <field name="project_id"/>
                <field name="requested_by"/>
                <filter string="Pending Approval" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Escalated to MD" name="filter_escalated" domain="[('escalated_to_md', '=', True)]"/>
                <filter string="Approved / In Progress" name="filter_approved" domain="[('state', 'in', ('approved', 'cs_in_progress', 'po_created'))]"/>
                <group>
                    <filter string="Project" name="group_project" domain="[]" context="{'group_by': 'project_id'}"/>
                    <filter string="Requester" name="group_requested_by" domain="[]" context="{'group_by': 'requested_by'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Required Date" name="group_required_date" domain="[]" context="{'group_by': 'required_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_contractor_material_requisition" model="ir.actions.act_window">
        <field name="name">Material Requisitions (MR)</field>
        <field name="res_model">contractor.material.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contractor_material_requisition_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Material Requisition for site requirements.
            </p>
        </field>
    </record>
</odoo>

